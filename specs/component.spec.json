{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-clawrouter",
    "displayName": "SDKWork Claw Router",
    "version": "0.3.0",
    "type": "app",
    "root": ".",
    "domain": "platform",
    "capability": "router",
    "surface": "gateway",
    "status": "standardizing",
    "languages": ["rust", "typescript", "javascript", "python"],
    "generated": false,
    "private": true,
    "manifests": [
      "Cargo.toml",
      "package.json",
      "sdkwork.app.config.json",
      "sdkwork.workflow.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "SDKWORK_WORKSPACE_SPEC.md",
      "path": "../sdkwork-specs/SDKWORK_WORKSPACE_SPEC.md",
      "purpose": "Repository root dictionary and application workspace metadata."
    },
    {
      "file": "CODE_STYLE_SPEC.md",
      "path": "../sdkwork-specs/CODE_STYLE_SPEC.md",
      "purpose": "Cross-language code organization and generated ownership."
    },
    {
      "file": "NAMING_SPEC.md",
      "path": "../sdkwork-specs/NAMING_SPEC.md",
      "purpose": "Canonical application, route, API, SDK, and crate naming."
    },
    {
      "file": "RUST_CODE_SPEC.md",
      "path": "../sdkwork-specs/RUST_CODE_SPEC.md",
      "purpose": "Rust route, service, repository, and gateway boundaries."
    },
    {
      "file": "TYPESCRIPT_CODE_SPEC.md",
      "path": "../sdkwork-specs/TYPESCRIPT_CODE_SPEC.md",
      "purpose": "TypeScript packages, public exports, and SDK ports."
    },
    {
      "file": "API_SPEC.md",
      "path": "../sdkwork-specs/API_SPEC.md",
      "purpose": "HTTP authority, route manifest, and wire contracts."
    },
    {
      "file": "WEB_FRAMEWORK_SPEC.md",
      "path": "../sdkwork-specs/WEB_FRAMEWORK_SPEC.md",
      "purpose": "Mandatory SDKWork HTTP framework integration."
    },
    {
      "file": "WEB_BACKEND_SPEC.md",
      "path": "../sdkwork-specs/WEB_BACKEND_SPEC.md",
      "purpose": "HTTP handler, service, repository, and adapter boundaries."
    },
    {
      "file": "SDK_SPEC.md",
      "path": "../sdkwork-specs/SDK_SPEC.md",
      "purpose": "Generated SDK semantics and composed consumer packages."
    },
    {
      "file": "SDK_WORKSPACE_GENERATION_SPEC.md",
      "path": "../sdkwork-specs/SDK_WORKSPACE_GENERATION_SPEC.md",
      "purpose": "Application SDK workspace materialization and generation."
    },
    {
      "file": "DATABASE_SPEC.md",
      "path": "../sdkwork-specs/DATABASE_SPEC.md",
      "purpose": "Database ownership, migrations, tenant scope, and transactions."
    },
    {
      "file": "SECURITY_SPEC.md",
      "path": "../sdkwork-specs/SECURITY_SPEC.md",
      "purpose": "Authentication, authorization, secrets, abuse, and egress safety."
    },
    {
      "file": "PRIVACY_SPEC.md",
      "path": "../sdkwork-specs/PRIVACY_SPEC.md",
      "purpose": "Sensitive data minimization, retention, and residency."
    },
    {
      "file": "APP_RUNTIME_TOPOLOGY_SPEC.md",
      "path": "../sdkwork-specs/APP_RUNTIME_TOPOLOGY_SPEC.md",
      "purpose": "Deployment profile, environment, ingress, and process topology."
    },
    {
      "file": "DEPLOYMENT_SPEC.md",
      "path": "../sdkwork-specs/DEPLOYMENT_SPEC.md",
      "purpose": "Standalone and cloud deployment parity."
    },
    {
      "file": "GITHUB_WORKFLOW_SPEC.md",
      "path": "../sdkwork-specs/GITHUB_WORKFLOW_SPEC.md",
      "purpose": "Packaging, release, publication, and deployment workflow."
    },
    {
      "file": "TEST_SPEC.md",
      "path": "../sdkwork-specs/TEST_SPEC.md",
      "purpose": "Contract, security, composition, runtime, and release evidence."
    }
  ],
  "contracts": {
    "publicExports": [
      "@sdkwork/clawrouter-app-sdk",
      "@sdkwork/clawrouter-backend-sdk",
      "@sdkwork/clawrouter-open-sdk"
    ],
    "runtimeEntrypoints": [
      "crates/sdkwork-clawrouter-standalone-gateway/src/main.rs",
      "crates/sdkwork-clawrouter-cloud-gateway/src/main.rs",
      "apps/sdkwork-clawrouter-pc/package.json#scripts"
    ],
    "routeManifest": null,
    "sdkClients": [
      "@sdkwork/clawrouter-app-sdk",
      "@sdkwork/clawrouter-backend-sdk",
      "@sdkwork/clawrouter-open-sdk"
    ],
    "sdkDependencies": [
      {
        "workspace": "sdkwork-iam-app-sdk",
        "role": "appbase-app-capability",
        "dependencyMode": "consumer-sdk"
      },
      {
        "workspace": "sdkwork-iam-backend-sdk",
        "role": "appbase-backend-management-capability",
        "dependencyMode": "consumer-sdk"
      }
    ],
    "permissionComposition": {
      "mode": "module-catalog-with-overrides",
      "moduleCatalogRefs": [
        {
          "workspace": "sdkwork-iam-app-sdk",
          "manifestRef": "../sdkwork-iam/iam/modules/iam-kernel/iam.module.manifest.json",
          "inheritPermissions": true
        },
        {
          "workspace": "sdkwork-iam-backend-sdk",
          "manifestRef": "../sdkwork-iam/iam/modules/iam-kernel/iam.module.manifest.json",
          "inheritPermissions": true
        }
      ]
    },
    "dependencyApiExports": [],
    "dependencyApiSurfaces": [
      {
        "workspace": "sdkwork-iam-app-sdk",
        "sdkFamily": "sdkwork-iam-app-sdk",
        "apiAuthority": "sdkwork-iam-app-api",
        "surface": "app-api",
        "connectivityPlane": "platform",
        "runtimeMode": "external-via-platform-gateway",
        "mountStatus": "not-mounted",
        "baseUrlConfigKey": "VITE_SDKWORK_APPBASE_APP_API_BASE_URL"
      },
      {
        "workspace": "sdkwork-iam-backend-sdk",
        "sdkFamily": "sdkwork-iam-backend-sdk",
        "apiAuthority": "sdkwork-iam-backend-api",
        "surface": "backend-api",
        "connectivityPlane": "platform",
        "runtimeMode": "external-via-platform-gateway",
        "mountStatus": "not-mounted",
        "baseUrlConfigKey": "VITE_SDKWORK_APPBASE_BACKEND_API_BASE_URL"
      }
    ],
    "events": [],
    "configKeys": [
      "sdkwork.app.config.json",
      "sdkwork.workflow.json",
      "specs/topology.spec.json",
      "etc/topology/*.env"
    ]
  },
  "integration": {
    "authority": "Global SDKWork specs and authored API contracts remain authoritative.",
    "compositionAuthority": "generated/composition.resolved.json",
    "defaultConnectivityPlane": "application",
    "defaultRuntimeMode": "same-origin-embedded",
    "dependencyPolicy": "Consume dependency APIs through declared generated SDKs and resolved composition. Do not copy dependency routes or transports.",
    "sdkPolicy": "Application and frontend code consume composed Claw Router SDK packages. Generated transport output is generator-owned.",
    "languagePolicy": "Language packages follow native manifests while preserving this component contract."
  },
  "verification": {
    "commands": [
      "pnpm topology:validate",
      "pnpm check",
      "pnpm verify",
      "cargo test --workspace"
    ]
  }
}

