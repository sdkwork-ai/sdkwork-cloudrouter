{
  "schemaVersion": 1,
  "kind": "sdkwork.process-database-pool",
  "profile": {
    "exampleFile": ".env.postgres.example",
    "database": "sdkwork_ai_dev",
    "schema": "sdkwork_ai_dev"
  },
  "processes": [
    {
      "id": "sdkwork-cloudrouter-standalone-gateway",
      "entrypoint": "services/sdkwork-cloudrouter-standalone-gateway/src/main.rs",
      "poolOwner": "services/sdkwork-cloudrouter-standalone-gateway/src/main.rs",
      "driver": "sqlx::PgPool",
      "poolCount": 1,
      "databaseUrlEnv": "SDKWORK_DATABASE_*",
      "schemaEnv": "SDKWORK_DATABASE_SCHEMA",
      "maxConnectionsEnv": "SDKWORK_DATABASE_MAX_CONNECTIONS",
      "productionSourceRoots": [
        "services/sdkwork-cloudrouter-standalone-gateway/src"
      ],
      "consumers": [
        {
          "module": "cloudrouter app routes",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-app-api/src/routes.rs"
          ]
        },
        {
          "module": "invoice runtime",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-app-api/src/invoice_runtime.rs"
          ]
        },
        {
          "module": "commerce runtime",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-app-api/src/commerce_runtime.rs"
          ]
        },
        {
          "module": "sdkwork-log module lifecycle + request log store",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-backend-api/src/routes.rs"
          ]
        }
      ],
      "temporaryDriverExceptions": []
    },
    {
      "id": "sdkwork-cloudrouter-admin-gateway",
      "entrypoint": "services/sdkwork-cloudrouter-admin-gateway/src/main.rs",
      "poolOwner": "services/sdkwork-cloudrouter-admin-gateway/src/main.rs",
      "driver": "sqlx::PgPool",
      "poolCount": 1,
      "databaseUrlEnv": "SDKWORK_DATABASE_*",
      "schemaEnv": "SDKWORK_DATABASE_SCHEMA",
      "maxConnectionsEnv": "SDKWORK_DATABASE_MAX_CONNECTIONS",
      "productionSourceRoots": [
        "services/sdkwork-cloudrouter-admin-gateway/src"
      ],
      "consumers": [
        {
          "module": "cloudrouter backend routes",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-backend-api/src/routes.rs"
          ]
        },
        {
          "module": "sdkwork-log module lifecycle + request log store",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-backend-api/src/routes.rs"
          ]
        }
      ],
      "temporaryDriverExceptions": []
    },
    {
      "id": "sdkwork-cloudrouter-edge-runtime",
      "entrypoint": "crates/sdkwork-cloudrouter-edge-runtime/src/main.rs",
      "poolOwner": "crates/sdkwork-cloudrouter-edge-runtime/src/main.rs",
      "driver": "sqlx::PgPool",
      "poolCount": 1,
      "databaseUrlEnv": "SDKWORK_DATABASE_*",
      "schemaEnv": "SDKWORK_DATABASE_SCHEMA",
      "maxConnectionsEnv": "SDKWORK_DATABASE_MAX_CONNECTIONS",
      "productionSourceRoots": [
        "crates/sdkwork-cloudrouter-edge-runtime/src"
      ],
      "consumers": [
        {
          "module": "cloudrouter router runtime",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-cloudrouter-edge-runtime/src/runtime.rs"
          ]
        },
        {
          "module": "sdkwork-log module lifecycle + request log store",
          "poolMode": "installed-process-pool",
          "evidence": [
            "crates/sdkwork-routes-cloudrouter-backend-api/src/routes.rs"
          ]
        }
      ],
      "temporaryDriverExceptions": []
    },
    {
      "id": "cloudrouterctl",
      "entrypoint": "services/sdkwork-cloudrouter-installer/src/main.rs",
      "poolOwner": "services/sdkwork-cloudrouter-installer/src/main.rs",
      "driver": "sqlx::PgPool",
      "poolCount": 1,
      "databaseUrlEnv": "SDKWORK_DATABASE_*",
      "schemaEnv": "SDKWORK_DATABASE_SCHEMA",
      "maxConnectionsEnv": "SDKWORK_DATABASE_MAX_CONNECTIONS",
      "productionSourceRoots": [
        "services/sdkwork-cloudrouter-installer/src"
      ],
      "consumers": [
        {
          "module": "cloudrouter installer lifecycle",
          "poolMode": "injected",
          "evidence": [
            "services/sdkwork-cloudrouter-installer/src/main.rs"
          ]
        },
        {
          "module": "models database lifecycle",
          "poolMode": "injected",
          "evidence": [
            "services/sdkwork-cloudrouter-installer/src/main.rs"
          ]
        }
      ],
      "temporaryDriverExceptions": []
    }
  ],
  "verification": [
    "node ../sdkwork-specs/tools/check-process-shared-database-pool.mjs --root .",
    "cargo check -p sdkwork-cloudrouter-edge-runtime",
    "cargo check -p sdkwork-cloudrouter-standalone-gateway"
  ]
}
