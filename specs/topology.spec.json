{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-cloudrouter",
  "applicationCode": "router",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production",
    "gatewayBind": "0.0.0.0:3900"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT",
    "profileId": "SDKWORK_CLOUDROUTER_ROUTER_PROFILE_ID",
    "standaloneGatewayBind": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientDeploymentProfile": "VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL"
    },
    "application.backend-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL"
    },
    "application.open-http": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_BIND",
      "httpUrlEnv": "SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "internalUpstreams": {
    "app-api": {
      "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_APP_API_BIND"
    },
    "portal-renderer": {
      "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND"
    }
  },
  "components": {
    "standaloneGateway": {
      "crate": "sdkwork-api-cloudrouter-standalone-gateway",
      "binary": "sdkwork-api-cloudrouter-standalone-gateway"
    },
    "portalRenderer": {
      "package": "apps/sdkwork-cloudrouter-pc",
      "script": "_sdkwork:client:browser"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-cloudrouter-standalone-gateway",
            "binary": "sdkwork-api-cloudrouter-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "portal-renderer",
            "package": "apps/sdkwork-cloudrouter-pc",
            "script": "_sdkwork:client:browser",
            "required": true,
            "role": "client",
            "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ]
          }
        ],
        "browserDeliveries": [
          {
            "id": "pc-web",
            "applicationRoot": "apps/sdkwork-cloudrouter-pc",
            "clientArchitectures": [
              "pc-web"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "apiSurfaceId": "application.public-ingress",
            "clientProcessId": "portal-renderer",
            "preserveCanonicalPaths": true
          }
        ],
        "accessEndpoints": [
          {
            "id": "application-ui",
            "kind": "user-interface",
            "source": {
              "processId": "portal-renderer"
            },
            "path": "/",
            "primary": true,
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ]
          },
          {
            "id": "application-api-reference",
            "kind": "api-reference",
            "source": {
              "surfaceId": "application.public-ingress"
            },
            "path": "/openapi.json",
            "runtimeTargets": [
              "browser"
            ]
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-cloudrouter-standalone-gateway",
            "binary": "sdkwork-api-cloudrouter-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "browserDeliveries": [
          {
            "id": "pc-web",
            "applicationRoot": "apps/sdkwork-cloudrouter-pc",
            "clientArchitectures": [
              "pc-web"
            ],
            "originMode": "same-origin",
            "deliveryMode": "gateway-static",
            "apiSurfaceId": "application.public-ingress",
            "hostProcessId": "application.public-ingress",
            "buildOutput": "apps/sdkwork-cloudrouter-pc/dist",
            "runtimeRootEnv": "SDKWORK_CLOUDROUTER_ROUTER_PORTAL_STATIC_DIST",
            "mountPath": "/",
            "spaFallback": "/index.html"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-cloudrouter-standalone-gateway",
            "binary": "sdkwork-api-cloudrouter-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "portal-renderer",
            "package": "apps/sdkwork-cloudrouter-pc",
            "script": "_sdkwork:client:browser",
            "required": true,
            "role": "client",
            "bindEnv": "SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ]
          }
        ],
        "browserDeliveries": [
          {
            "id": "pc-web",
            "applicationRoot": "apps/sdkwork-cloudrouter-pc",
            "clientArchitectures": [
              "pc-web"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "apiSurfaceId": "application.public-ingress",
            "clientProcessId": "portal-renderer",
            "preserveCanonicalPaths": true
          }
        ],
        "accessEndpoints": [
          {
            "id": "application-ui",
            "kind": "user-interface",
            "source": {
              "processId": "portal-renderer"
            },
            "path": "/",
            "primary": true,
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web"
            ]
          },
          {
            "id": "application-api-reference",
            "kind": "api-reference",
            "source": {
              "surfaceId": "application.public-ingress"
            },
            "path": "/openapi.json",
            "runtimeTargets": [
              "browser"
            ]
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-cloudrouter-standalone-gateway",
            "binary": "sdkwork-api-cloudrouter-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "browserDeliveries": [
          {
            "id": "pc-web",
            "applicationRoot": "apps/sdkwork-cloudrouter-pc",
            "clientArchitectures": [
              "pc-web"
            ],
            "originMode": "same-origin",
            "deliveryMode": "gateway-static",
            "apiSurfaceId": "application.public-ingress",
            "hostProcessId": "application.public-ingress",
            "buildOutput": "apps/sdkwork-cloudrouter-pc/dist",
            "runtimeRootEnv": "SDKWORK_CLOUDROUTER_ROUTER_PORTAL_STATIC_DIST",
            "mountPath": "/",
            "spaFallback": "/index.html"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.test": {
        "processes": [
          {
            "id": "portal-renderer",
            "package": "apps/sdkwork-cloudrouter-pc",
            "script": "_sdkwork:client:browser",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      }
    }
  },
  "packaging": {
    "targets": []
  },
  "scripts": {
    "applicationDev": "scripts/cloud-router-dev.mjs",
    "pnpm": {
      "dev": {
        "script": "dev",
        "deploymentProfile": "standalone",
        "runtimeTarget": "browser",
        "database": "postgres"
      },
      "dev:browser:postgres:standalone": {
        "script": "dev:browser:postgres:standalone",
        "deploymentProfile": "standalone",
        "runtimeTarget": "browser",
        "database": "postgres"
      },
      "dev:cloud": {
        "script": "dev:cloud",
        "deploymentProfile": "cloud",
        "runtimeTarget": "browser"
      },
      "dev:browser:cloud": {
        "script": "dev:browser:cloud",
        "deploymentProfile": "cloud",
        "runtimeTarget": "browser"
      },
      "dev:desktop": {
        "script": "dev:desktop",
        "deploymentProfile": "standalone",
        "runtimeTarget": "desktop",
        "database": "postgres"
      },
      "topology:validate": {
        "script": "topology:validate",
        "command": "sdkwork-topology validate"
      },
      "gateway:matrix": {
        "script": "gateway:matrix",
        "command": "sdkwork-topology print-matrix --profile all"
      }
    }
  },
  "retired": {
    "vocabulary": {
      "serviceLayout": [
        "unified-process",
        "split-services"
      ],
      "hosting": [
        "self-hosted",
        "cloud-hosted"
      ]
    },
    "envKeys": [
      "SDKWORK_CLOUDROUTER_TOPOLOGY",
      "VITE_CLOUDROUTER_TOPOLOGY",
      "SDKWORK_CLOUDROUTER_ROUTER_HOSTING",
      "VITE_SDKWORK_CLOUDROUTER_ROUTER_HOSTING"
    ],
    "profileIds": [
      "standalone.split-services.development",
      "cloud.unified-process.development",
      "self-hosted.unified-process.development",
      "cloud-hosted.split-services.production"
    ],
    "cliFlags": [
      "--topology",
      "--service-layout",
      "--internal-distributed",
      "--all-in-one"
    ]
  },
