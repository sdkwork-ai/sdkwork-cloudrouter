# Copy to .env.release on a release host. Do not commit host profile secrets.
# `pnpm start` generates or refreshes .env.release on startup while preserving existing non-empty values.

SDKWORK_CLAW_CONFIG_PROFILE=release
SDKWORK_CLAW_ENVIRONMENT=production
SDKWORK_CLAW_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLAW_RUNTIME_TARGET=server

# Private bootstrap access credential for release host process bootstrap.
# Generated on release startup; do not commit live values.
SDKWORK_ACCESS_TOKEN=

# Release profile refuses to start when database passwords still contain the
# <CHANGE_ME> placeholder. Provide a real Postgres connection via the runtime
# TOML or SDKWORK_CLAW_DATABASE_URL before launching the release host.
PORTAL_PUBLIC_SDK_BASE_URL="/"
PORTAL_PUBLIC_API_BASE_URL="/v1"
PORTAL_PUBLIC_OPEN_API_BASE_URL=""
PORTAL_PUBLIC_APP_API_BASE_URL="/app/v3/api"
PORTAL_PUBLIC_BACKEND_API_BASE_URL="/backend/v3/api"
PORTAL_PUBLIC_APPBASE_BACKEND_API_BASE_URL=""
PORTAL_PUBLIC_TOOL_API_ENABLED="false"

# Private Rust edge-server settings (not browser-visible).
SDKWORK_CLAW_EDGE_CSP_CONNECT_SRC=""
SDKWORK_CLAW_TOOL_API_RATE_LIMIT_REQUESTS="120"
SDKWORK_CLAW_TOOL_API_RATE_LIMIT_WINDOW_SECONDS="60"
SDKWORK_CLAW_TOOL_API_SDK_GENERATOR_BASE_URL=""
SDKWORK_CLAW_TOOL_API_SDK_GENERATOR_API_KEY=""
SDKWORK_CLAW_TOOL_API_SDK_ARCHIVE_ROOT=""
