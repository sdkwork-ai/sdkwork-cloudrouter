{
  "schemaVersion": 2,
  "kind": "sdkwork.database.module",
  "databaseRole": "authoritative-server",
  "moduleId": "pricing",
  "serviceCode": "SDKWORK_PRICING",
  "displayName": "SDKWork Reusable Pricing Database",
  "owner": "pricing-service",
  "engines": [
    "postgres"
  ],
  "defaultEngine": "postgres",
  "tablePrefixes": [
    "pricing_"
  ],
  "contractVersion": "0.4.0",
  "baselineStrategy": "baseline-plus-migrations",
  "baselineAnchorTable": "pricing_product",
  "modules": [],
  "lifecycle": {
    "autoMigrate": false,
    "seedOnBoot": false,
    "defaultSeedLocale": "zh-CN",
    "defaultSeedProfile": "standard",
    "supportedSeedLocales": [
      "zh-CN",
      "en-US"
    ],
    "activeSeedLocales": [
      "zh-CN"
    ],
    "driftCheckIntervalSec": 60
  },
  "paths": {
    "contract": "contract/schema.yaml",
    "migrations": "migrations",
    "seeds": "seeds",
    "driftPolicy": "drift/policy.yaml"
  },
  "spi": {
    "provider": "default",
    "hooks": []
  },
  "materializedTableCount": 12,
  "materializedTables": [
    "pricing_import_run",
    "pricing_meter",
    "pricing_operation",
    "pricing_price_book",
    "pricing_product",
    "pricing_product_binding",
    "pricing_rate",
    "pricing_rate_binding",
    "pricing_rate_condition",
    "pricing_rate_formula",
    "pricing_rate_formula_term",
    "pricing_rate_tier"
  ]
}
