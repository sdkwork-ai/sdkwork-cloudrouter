{
  "schemaVersion": 2,
  "kind": "sdkwork.database.module",
  "databaseRole": "authoritative-server",
  "moduleId": "ai-metering",
  "serviceCode": "CLOUD_ROUTER_AI_METERING",
  "displayName": "Cloud Router AI Metering Database",
  "owner": "cloud-router-platform",
  "engines": [
    "postgres"
  ],
  "defaultEngine": "postgres",
  "tablePrefix": "ai_metering_",
  "contractVersion": "0.2.0",
  "baselineStrategy": "baseline-plus-migrations",
  "baselineAnchorTable": "ai_metering_usage",
  "modules": [],
  "lifecycle": {
    "autoMigrate": false,
    "seedOnBoot": false,
    "defaultSeedLocale": "zh-CN",
    "defaultSeedProfile": "standard",
    "supportedSeedLocales": [
      "zh-CN",
      "en-US",
      "ja-JP",
      "de-DE",
      "fr-FR",
      "ru-RU",
      "ko-KR"
    ],
    "activeSeedLocales": [
      "zh-CN"
    ],
    "driftCheckIntervalSec": 60
  },
  "paths": {
    "contract": "contract/schema.yaml",
    "migrations": "migrations",
    "seeds": "seeds",
    "driftPolicy": "drift/policy.yaml"
  },
  "spi": {
    "provider": "default",
    "hooks": []
  }
}
