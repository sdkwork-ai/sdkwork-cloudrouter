{
  "schemaVersion": 2,
  "kind": "sdkwork.database.module",
  "moduleId": "cloudrouter",
  "serviceCode": "CLOUD_ROUTER",
  "displayName": "Cloud Router AI Database",
  "owner": "cloud-router-platform",
  "engines": [
    "postgres"
  ],
  "defaultEngine": "postgres",
  "contractVersion": "0.4.0",
  "baselineStrategy": "baseline-plus-migrations",
  "baselineAnchorTable": "ai_upstream_supplier",
  "modules": [
    "gateway-iam",
    "operations"
  ],
  "lifecycle": {
    "autoMigrate": false,
    "seedOnBoot": false,
    "defaultSeedLocale": "zh-CN",
    "defaultSeedProfile": "standard",
    "supportedSeedLocales": [
      "zh-CN",
      "en-US",
      "ja-JP",
      "de-DE",
      "fr-FR",
      "ru-RU",
      "ko-KR"
    ],
    "activeSeedLocales": [
      "zh-CN",
      "en-US"
    ],
    "driftCheckIntervalSec": 60
  },
  "paths": {
    "contract": "contract/schema.yaml",
    "migrations": "migrations",
    "seeds": "seeds",
    "driftPolicy": "drift/policy.yaml"
  },
  "spi": {
    "provider": "default",
    "hooks": []
  },
  "materializedTableCount": 38,
  "materializedTables": [
    "ai_chat_context_snapshot",
    "ai_chat_conversation",
    "ai_chat_item",
    "ai_chat_message",
    "ai_chat_message_part",
    "ai_chat_turn",
    "ai_config_change_event",
    "ai_config_version",
    "ai_model_mapping_rule",
    "ai_model_mapping_rule_binding",
    "ai_model_mapping_rule_item",
    "ai_pricing_import_snapshot",
    "ai_pricing_plan",
    "ai_pricing_plan_binding",
    "ai_pricing_rule",
    "ai_pricing_tier",
    "ai_quota_policy",
    "ai_request_trace",
    "ai_routing_decision_log",
    "ai_routing_policy",
    "ai_routing_profile",
    "ai_routing_rule",
    "ai_runtime_invocation",
    "ai_runtime_usage_link",
    "ai_upstream_account",
    "ai_upstream_account_credential",
    "ai_upstream_account_group",
    "ai_upstream_account_group_member",
    "ai_upstream_account_group_metric_snapshot",
    "ai_upstream_account_group_resource",
    "ai_upstream_account_health_state",
    "ai_upstream_object_route",
    "ai_upstream_supplier",
    "ai_upstream_supplier_auth_method",
    "ai_upstream_supplier_endpoint",
    "ai_upstream_supplier_endpoint_health_state",
    "ai_upstream_supplier_resource",
    "ai_usage",
    "object_provider",
    "object_bucket",
    "storage_default_bucket_policy",
    "storage_quota_policy",
    "storage_usage_counter",
    "storage_usage_ledger",
    "storage_usage_snapshot",
    "storage_reconciliation_run",
    "storage_gc_job"
  ],
  "databaseRole": "authoritative-server",
  "tablePrefix": "ai_"
}
