    "ai_config_version",
    "ai_model_mapping_rule",
    "ai_model_mapping_rule_binding",
    "ai_model_mapping_rule_item",
    "ai_pricing_import_snapshot",
    "ai_pricing_plan",
    "ai_pricing_plan_binding",
    "ai_pricing_rule",
    "ai_pricing_tier",
    "ai_provider",
    "ai_provider_object_route",
    "ai_quota_policy",
    "ai_request_trace",
    "ai_routing_decision_log",
    "ai_routing_policy",
    "ai_routing_profile",
    "ai_routing_rule",
    "ai_site",
    "ai_site_service",
    "ai_usage",
    "ai_usage_service_provider_edge",
    "iam_gateway_access_policy",
    "iam_gateway_api_key",
    "iam_gateway_api_key_channel_group",
    "iam_gateway_risk_rule",
