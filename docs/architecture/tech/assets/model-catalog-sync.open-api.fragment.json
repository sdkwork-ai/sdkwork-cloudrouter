      "CatalogPresentation": {
        "type": "object",
        "additionalProperties": false,
        "description": "Resolved presentation policy for this catalog. The admin Models page authors it; every omitted stored field resolves to the shipped default.",
        "properties": {
          "openApiEnabled": {
            "type": "boolean",
            "description": "Whether the open-api surface is served to API-key callers."
          },
          "appApiEnabled": {
            "type": "boolean",
            "description": "Whether the app-api surface is served to signed-in clients."
          },
          "includeParameters": {
            "type": "boolean",
            "description": "Whether a snapshot includes the parameter registry when include is omitted."
          },
          "includePricing": {
            "type": "boolean",
            "description": "Whether a snapshot includes reference prices when include is omitted."
          },
          "includeExtensions": {
            "type": "boolean",
            "description": "Whether a snapshot includes namespaced extension data when include is omitted."
