{
  "openapi": "3.1.2",
  "info": {
    "title": "SDKWork Cloud Router Model Catalog Sync Open API",
    "version": "1.0.0",
    "description": "Versioned read-only model catalog for external API-key integrations. Serves the vendor catalog, each vendor's models, the model parameter registry, and an incremental delta feed. Authoring input for the generated open-api authority; see docs/architecture/tech/TECH-2026-11-15-model-catalog-sync-api.md.",
    "x-sdkwork-domain": "intelligence",
    "x-sdkwork-api-authority": "sdkwork-cloudrouter-open-api",
    "x-sdkwork-api-surface": "open-api",
    "x-sdkwork-source-route-crate": "sdkwork-routes-cloudrouter-llm-open-api"
  },
  "servers": [
    {
      "url": "https://api.sdkwork.com",
      "description": "Production gateway."
    }
  ],
  "tags": [
    {
      "name": "model_catalog",
      "description": "Versioned model catalog synchronization."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/model_catalog": {
      "get": {
        "tags": [
          "model_catalog"
        ],
        "operationId": "modelCatalog.retrieve",
        "summary": "Retrieve the current model catalog snapshot",
        "description": "Returns one revision of the model catalog. Follow `pageInfo.nextCursor` until `hasMore` is false; every page of one snapshot reports the same `revision`. Send `If-None-Match` with the previously stored `ETag` to receive `304 Not Modified`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/VendorQuery"
          },
          {
            "$ref": "#/components/parameters/RegionQuery"
          },
          {
            "$ref": "#/components/parameters/CapabilityQuery"
          },
          {
            "$ref": "#/components/parameters/InputModalityQuery"
          },
          {
            "$ref": "#/components/parameters/OutputModalityQuery"
          },
          {
            "$ref": "#/components/parameters/IncludeQuery"
          },
          {
            "$ref": "#/components/parameters/PageSizeQuery"
          },
          {
            "$ref": "#/components/parameters/CursorQuery"
          },
          {
            "$ref": "#/components/parameters/PageQuery"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatchHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the current catalog snapshot.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalog-Revision": {
                "$ref": "#/components/headers/CatalogRevision"
              },
              "X-Catalog-Version": {
                "$ref": "#/components/headers/CatalogVersion"
              },
              "X-Catalog-Schema-Version": {
                "$ref": "#/components/headers/CatalogSchemaVersion"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/PrivateCache"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSnapshot"
                }
              }
            }
          },
          "304": {
            "description": "The stored ETag already describes the current revision.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "x-contract-kind": "read",
        "x-route-scope": "external",
        "x-sdkwork-auth-mode": "api-key-or-dual-token",
        "x-sdkwork-required-surface": "organizationMember"
      }
    },
    "/v1/model_catalog/changes": {
      "get": {
        "tags": [
          "model_catalog"
        ],
        "operationId": "modelCatalog.listChanges",
        "summary": "List catalog changes since a revision",
        "description": "Returns the rows that changed after `since_revision`, including tombstones for removed models. `baseRevision` must equal the client's stored revision; otherwise the client performs a full snapshot resync. Reapplying the same delta is a no-op.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SinceRevisionQuery"
          },
          {
            "$ref": "#/components/parameters/VendorQuery"
          },
          {
            "$ref": "#/components/parameters/RegionQuery"
          },
          {
            "$ref": "#/components/parameters/PageSizeQuery"
          },
          {
            "$ref": "#/components/parameters/IfNoneMatchHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "A delta between two consecutive revisions.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalog-Revision": {
                "$ref": "#/components/headers/CatalogRevision"
              },
              "X-Catalog-Version": {
                "$ref": "#/components/headers/CatalogVersion"
              },
              "X-Catalog-Schema-Version": {
                "$ref": "#/components/headers/CatalogSchemaVersion"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/PrivateCache"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogDelta"
                }
              }
            }
          },
          "304": {
            "description": "No catalog change since the stored ETag.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "x-contract-kind": "read",
        "x-route-scope": "external",
        "x-sdkwork-auth-mode": "api-key-or-dual-token",
        "x-sdkwork-required-surface": "organizationMember"
      }
    },
    "/v1/model_catalog/vendors": {
      "get": {
        "tags": [
          "model_catalog"
        ],
        "operationId": "modelCatalog.listVendors",
        "summary": "List catalog vendors",
        "description": "Returns every vendor offered in the requested region, with the number of models the current revision exposes for it.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RegionQuery"
          },
          {
            "$ref": "#/components/parameters/CapabilityQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Vendor rows of the current revision.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalog-Revision": {
                "$ref": "#/components/headers/CatalogRevision"
              },
              "X-Catalog-Version": {
                "$ref": "#/components/headers/CatalogVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogVendorList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "x-contract-kind": "read",
        "x-route-scope": "external",
        "x-sdkwork-auth-mode": "api-key-or-dual-token",
        "x-sdkwork-required-surface": "organizationMember"
      }
    },
    "/v1/model_catalog/models/{vendor_code}/{model_id}": {
      "get": {
        "tags": [
          "model_catalog"
        ],
        "operationId": "modelCatalog.retrieveModel",
        "summary": "Retrieve one catalog model",
        "description": "Returns one model by its vendor code and vendor-local model id.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/VendorCodePath"
          },
          {
            "$ref": "#/components/parameters/ModelIdPath"
          },
          {
            "$ref": "#/components/parameters/RegionQuery"
          },
          {
            "$ref": "#/components/parameters/IncludeQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested model row.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalog-Revision": {
                "$ref": "#/components/headers/CatalogRevision"
              },
              "X-Catalog-Version": {
                "$ref": "#/components/headers/CatalogVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogModel"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "x-contract-kind": "read",
        "x-route-scope": "external",
        "x-sdkwork-auth-mode": "api-key-or-dual-token",
        "x-sdkwork-required-surface": "organizationMember"
      }
    },
    "/v1/model_catalog/parameters": {
      "get": {
        "tags": [
          "model_catalog"
        ],
        "operationId": "modelCatalog.listParameters",
        "summary": "List the model parameter registry",
        "description": "Returns the parameter descriptors referenced by model rows in this revision. A descriptor states type, range, enum, protocol applicability, and lifecycle.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The parameter registry of the current revision.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Catalog-Revision": {
                "$ref": "#/components/headers/CatalogRevision"
              },
              "X-Catalog-Version": {
                "$ref": "#/components/headers/CatalogVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParameterRegistry"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "x-contract-kind": "read",
        "x-route-scope": "external",
        "x-sdkwork-auth-mode": "api-key-or-dual-token",
        "x-sdkwork-required-surface": "organizationMember"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Cloud Router API key",
        "description": "Cloud Router API key or SDKWork IAM login auth token."
      }
    },
    "parameters": {
      "VendorQuery": {
        "name": "vendor",
        "in": "query",
        "required": false,
        "description": "Vendor code filter. Repeat the parameter or comma-separate values.",
        "schema": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        }
      },
      "RegionQuery": {
        "name": "region",
        "in": "query",
        "required": false,
        "description": "Region code filter. Defaults to `global`.",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "default": "global"
        }
      },
      "CapabilityQuery": {
        "name": "capability",
        "in": "query",
        "required": false,
        "description": "Capability code filter. Unknown codes are rejected; open value sets are documented in the catalog standard.",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "InputModalityQuery": {
        "name": "input_modality",
        "in": "query",
        "required": false,
        "description": "Accepted input modality filter.",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "OutputModalityQuery": {
        "name": "output_modality",
        "in": "query",
        "required": false,
        "description": "Produced output modality filter.",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "IncludeQuery": {
        "name": "include",
        "in": "query",
        "required": false,
        "description": "Comma list of optional sections: `parameters`, `pricing`, `extensions`.",
        "schema": {
          "type": "string",
          "default": "parameters"
        }
      },
      "PageSizeQuery": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "description": "Page size.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "CursorQuery": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque cursor from `pageInfo.nextCursor`. Mutually exclusive with `page`.",
        "schema": {
          "type": "string",
          "maxLength": 512
        }
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "One-based page number. Mutually exclusive with `cursor`.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "default": 1
        }
      },
      "SinceRevisionQuery": {
        "name": "since_revision",
        "in": "query",
        "required": true,
        "description": "Revision the client already holds. The response base must equal it.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "VendorCodePath": {
        "name": "vendor_code",
        "in": "path",
        "required": true,
        "description": "Vendor code (the first catalog-key segment).",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        }
      },
      "ModelIdPath": {
        "name": "model_id",
        "in": "path",
        "required": true,
        "description": "Vendor-local model id (the second catalog-key segment).",
        "schema": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "IfNoneMatchHeader": {
        "name": "If-None-Match",
        "in": "header",
        "required": false,
        "description": "The `ETag` of the stored snapshot.",
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "Strong validator `\"mcat-<revision>-<sha256-prefix-16>\"`.",
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      },
      "CatalogRevision": {
        "description": "Numeric catalog revision.",
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "CatalogVersion": {
        "description": "`sdkwork-models` data release version.",
        "schema": {
          "type": "string"
        }
      },
      "CatalogSchemaVersion": {
        "description": "Catalog contract schema version.",
        "schema": {
          "type": "string"
        }
      },
      "PrivateCache": {
        "description": "Private caching policy.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds the client must wait before retrying.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request or unknown cursor.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid credential.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The credential lacks the `model_catalog:read` scope.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFound": {
        "description": "The catalog key does not exist in the current revision.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "Conflict": {
        "description": "The requested revision left the delta retention window; perform a full resync.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Unsupported catalog schema major.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The catalog projection is temporarily unavailable.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "Extensions": {
        "type": "object",
        "description": "Namespaced extension data. Keys use `<namespace>.<name>`; `sdkwork`, `cloudrouter`, and `x-` are reserved. Clients preserve unknown entries.",
        "additionalProperties": true
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination state of one snapshot page.",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "offset",
              "cursor"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasMore": {
            "type": "boolean"
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "mode",
          "hasMore"
        ]
      },
      "CatalogVendor": {
        "type": "object",
        "description": "One vendor offered in one region.",
        "additionalProperties": false,
        "properties": {
          "vendorCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "regionCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "modelCount": {
            "type": "integer",
            "minimum": 0
          },
          "capabilities": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "homepageUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "extensions": {
            "$ref": "#/components/schemas/Extensions"
          }
        },
        "required": [
          "vendorCode",
          "regionCode",
          "displayName",
          "modelCount",
          "capabilities"
        ]
      },
      "ParameterDescriptor": {
        "type": "object",
        "description": "One request parameter a model may accept.",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 128
          },
          "wireName": {
            "type": "string",
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "enum",
              "array",
              "object"
            ]
          },
          "enum": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "multipleOf": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minLength": {
            "type": "integer",
            "minimum": 0
          },
          "maxLength": {
            "type": "integer",
            "minimum": 0
          },
          "default": {
            "description": "Descriptor-level default value."
          },
          "required": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "enum": [
              "request",
              "route"
            ]
          },
          "protocols": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "deprecated",
              "experimental"
            ]
          },
          "replacement": {
            "type": "string",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "extensions": {
            "$ref": "#/components/schemas/Extensions"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "ParameterRegistry": {
        "type": "object",
        "description": "Parameter descriptors referenced by the catalog revision.",
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "const": "model_catalog.parameters"
          },
          "schemaVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "parameterRegistryVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "parameters": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "$ref": "#/components/schemas/ParameterDescriptor"
            }
          },
          "extensions": {
