          "exposeDeprecatedModels": {
            "type": "boolean",
            "description": "Whether deprecated and retired models stay in the served catalog."
          },
          "defaultPageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 500,
            "description": "Snapshot page size when the caller omits page_size."
