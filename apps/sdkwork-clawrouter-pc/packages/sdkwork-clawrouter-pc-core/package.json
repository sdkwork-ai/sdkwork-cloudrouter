{
  "name": "@sdkwork/clawrouter-pc-core",
  "private": true,
  "license": "SEE LICENSE IN ../../../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./modules": {
      "types": "./src/modules/index.ts",
      "import": "./src/modules/index.ts",
      "default": "./src/modules/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "import": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "import": "./src/composition/index.ts",
      "default": "./src/composition/index.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "clawrouter-app-domain-transport-generated-typescript": "workspace:*",
    "clawrouter-backend-domain-transport-generated-typescript": "workspace:*",
    "sdkwork-drive-backend-sdk-generated-typescript": "workspace:*",
    "sdkwork-generations-app-sdk-generated-typescript": "workspace:*"
  }
