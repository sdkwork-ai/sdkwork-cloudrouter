    "check:dependencies": "node scripts/check-portal-deps.mjs",
    "predev": "node ../../scripts/ensure-claw-router-env.mjs --lifecycle dev",
    "dev": "pnpm dev:standalone",
    "dev:browser": "pnpm dev:browser:postgres:standalone",
    "dev:desktop": "pnpm dev:desktop:postgres:standalone",
    "dev:server": "pnpm exec sdkwork-app dev --root ../.. --runtime-target server --deployment-profile standalone",
    "topology:plan:server": "node ../../scripts/run-claw-router-application.mjs plan",
    "prebuild": "node ../../scripts/ensure-claw-router-env.mjs --lifecycle build",
    "build": "pnpm check:dependencies && node scripts/build-portal.mjs",
    "preview": "vite preview --configLoader native",
    "start": "node ../../scripts/start-claw-router-production.mjs",
    "check": "pnpm typecheck && pnpm build",
    "clean": "rm -rf dist packages/*/dist",
    "lint": "tsc -p tsconfig.typecheck.json --noEmit",
    "check:size": "size-limit",
    "test:e2e": "playwright test",
    "test:commerce": "node --import tsx --test commerce-debt-runtime.test.ts commerce-business-runtime.test.ts sdk-composition-standard.test.mjs",
    "test:portal-alignment": "node --test vite-config-runtime.test.ts sdk-composition-standard.test.mjs scripts/portal-workspace-package-resolver.test.mjs",
    "test:admin": "pnpm --filter @sdkwork/clawrouter-pc-admin-dashboard test && pnpm --filter @sdkwork/clawrouter-pc-admin-site test && pnpm --filter @sdkwork/clawrouter-pc-admin-runtime-region test && pnpm --filter @sdkwork/clawrouter-pc-admin-cache test && pnpm exec vitest run admin-delete-semantics.test.ts --config vite.config.ts --configLoader native --pool vmThreads && node --import tsx --test admin-sidebar-runtime.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "dev:browser:postgres:standalone": "pnpm exec sdkwork-app dev --root ../.. --runtime-target browser --deployment-profile standalone",
    "dev:desktop:postgres:standalone": "pnpm exec sdkwork-app dev --root ../.. --runtime-target desktop --deployment-profile standalone",
    "_sdkwork:client:browser": "pnpm check:dependencies && node --import ./scripts/register-portal-workspace-resolver.mjs ./node_modules/vite/bin/vite.js --configLoader native",
    "test": "pnpm run test:admin && pnpm run test:commerce && pnpm run test:portal-alignment",
    "verify": "pnpm check && pnpm test"
  },
