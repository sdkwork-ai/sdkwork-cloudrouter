# SDKWork Cloud Router browser development profile (.env.standalone.development).
# Generated by scripts/dev/cloud-router-application-env.mjs on workspace startup.
# Uses VITE_* browser values and SDKWORK_CLOUDROUTER_* private dev proxy origins.
# PORTAL_PUBLIC_* belongs in .env.standalone.production only (see specs/application-env-standard.md).
# Existing non-empty values in this file are preserved across restarts.

# SDKWork application profile metadata.
SDKWORK_CLOUDROUTER_ROUTER_CONFIG_PROFILE=dev
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=development
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=browser

# Private Vite dev-server proxy upstream origins (process-only, not browser-visible).
# Defaults to the integrated Rust edge server at http://127.0.0.1:3900.
# Upstream origin for /v1, /openapi.json, and OpenAI-compatible gateway routes.
SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_OPEN_API_ORIGIN=http://127.0.0.1:3905
# Upstream origin for /backend/v3/api admin SDK routes.
SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_BACKEND_API_ORIGIN=http://127.0.0.1:3905
# Upstream origin for /app/v3/api product SDK routes.
SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_APP_API_ORIGIN=http://127.0.0.1:3905

# Browser-visible SDKWork application identity from agent.app.config.json app.key.
# SDKWork application key from agent.app.config.json.
VITE_SDKWORK_APP_ID=sdkwork-cloudrouter

# Browser-visible SDK base URLs (Vite-inlined in development).
# Production uses PORTAL_PUBLIC_* on the release host, mapped to VITE_* via /runtime-env.js.
# Public API reference and generic SDK root path.
VITE_API_BASE_URL=/v1
# @sdkwork/cloudrouter-open-sdk base URL.
VITE_CLOUDROUTER_OPEN_API_BASE_URL=/v1
# @sdkwork/cloudrouter-app-sdk base URL.
VITE_CLOUDROUTER_APP_API_BASE_URL=/app/v3/api
# @sdkwork/cloudrouter-backend-sdk base URL.
VITE_CLOUDROUTER_BACKEND_API_BASE_URL=/backend/v3/api
# @sdkwork/drive-admin-storage-sdk / drive backend base URL (same-origin /backend/v3/api in standalone dev).
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=/backend/v3/api
VITE_SDKWORK_FEEDS_OPEN_API_BASE_URL=/feeds/v3/api

# Enables local browser tool UI (API reference codegen). Keep false for production-like dev.
# Browser gate for local tool/codegen routes.
VITE_TOOL_API_ENABLED=false
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18080
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:4734
VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=development
VITE_SDKWORK_CLOUDROUTER_ROUTER_PROFILE_ID=standalone.development
VITE_SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=browser
VITE_SDKWORK_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_ENVIRONMENT=development
VITE_SDKWORK_PROFILE_ID=standalone.development
VITE_SDKWORK_RUNTIME_TARGET=browser
VITE_SDKWORK_APPBASE_BACKEND_API_BASE_URL=/backend/v3/api
SDKWORK_ACCESS_TOKEN=eyJhbGciOiJub25lIiwia2lkIjoicHVibGljLWFwcC10b2tlbiIsInR5cCI6IkpXVCJ9..public
