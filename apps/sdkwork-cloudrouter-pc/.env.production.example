# SDKWork Cloud Router browser production profile (.env.production).
# Copy to .env.production before portal production build. Startup/build scripts
# merge generated defaults while preserving existing non-empty values.
# See specs/application-env-standard.md.

SDKWORK_CLOUDROUTER_ROUTER_CONFIG_PROFILE=prod
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=production
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=browser
