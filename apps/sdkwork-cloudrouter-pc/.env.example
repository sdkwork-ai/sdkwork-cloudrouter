# Release-host browser runtime reference (.env.example).
# PORTAL_PUBLIC_* values are consumed by the Rust edge server and exposed to the
# browser through /runtime-env.js. They belong in .env.release on the host, not
# in .env.development. For local Vite development see .env.development.example.

# Browser-visible portal runtime configuration.
# These values are served by /runtime-env.js in production and can be changed
# without rebuilding the portal bundle.

# Common public SDK root. Generated SDK surface URLs default to this root plus
# their standard prefixes: /v1, /app/v3/api, and /backend/v3/api.
# Per-surface values below override this default.
PORTAL_PUBLIC_SDK_BASE_URL="/"

# Default gateway API base URL used by public API reference and SDK clients.
# Defaults to PORTAL_PUBLIC_SDK_BASE_URL + /v1 when the common SDK root is set.
# Keep the checked-in default same-origin so browser traffic goes through the
# configured SDKWork API entrypoint: sdkwork-api-cloud-gateway in client development
# or the packaged Rust edge server in production. Use an explicit HTTP/HTTPS
# URL only for a deployment override.
PORTAL_PUBLIC_API_BASE_URL="/v1"

# Optional OpenAI-compatible API base URL override for generated
# @sdkwork/cloudrouter-open-sdk clients. Defaults to PORTAL_PUBLIC_API_BASE_URL
# or PORTAL_PUBLIC_SDK_BASE_URL + /v1.
PORTAL_PUBLIC_OPEN_API_BASE_URL="/v1"

# Optional app API base URL override for generated @sdkwork/cloudrouter-app-sdk clients.
# Defaults to PORTAL_PUBLIC_SDK_BASE_URL + /app/v3/api, then the same-origin
# SDKWork API entrypoint path.
PORTAL_PUBLIC_APP_API_BASE_URL="/app/v3/api"

# Optional backend API base URL override for generated @sdkwork/cloudrouter-backend-sdk clients.
# Defaults to PORTAL_PUBLIC_SDK_BASE_URL + /backend/v3/api, then the
# same-origin SDKWork API entrypoint path.
PORTAL_PUBLIC_BACKEND_API_BASE_URL="/backend/v3/api"

# Required when admin IAM pages consume @sdkwork/iam-backend-sdk routes
# that are not mounted by the cloud-router backend runtime and no common
# PORTAL_PUBLIC_SDK_BASE_URL points to a gateway serving those routes. Point
# this to the appbase backend API base URL that serves /backend/v3/api.
PORTAL_PUBLIC_APPBASE_BACKEND_API_BASE_URL=""

# Build-time base URL for drive-owned backend surfaces (/backend/v3/api/drive/*)
# consumed by @sdkwork/drive-admin-storage-sdk (storage center providers/buckets).
# The drive surface is owned by the sdkwork-drive application and is not served by
# the cloud-router backend; set this to the drive backend gateway origin per
# deployment profile (standalone: http://127.0.0.1:3900; cloud:
# https://drive.sdkwork.com). Value is normalized so a /backend/v3/api suffix is
# stripped; the SDK appends the full /backend/v3/api/drive/... path itself.
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=""

# Enables local browser tool UI for SDK/code-snippet generation when paired with
# PORTAL_PUBLIC_TOOL_API_ENABLED=true on the serving API entrypoint. Keep false
# for public production deployments.
PORTAL_PUBLIC_TOOL_API_ENABLED="false"

# Server-side rate limit for the Rust edge local tool API when it is enabled.
SDKWORK_CLOUDROUTER_TOOL_API_RATE_LIMIT_REQUESTS="120"
SDKWORK_CLOUDROUTER_TOOL_API_RATE_LIMIT_WINDOW_SECONDS="60"

# Optional SDK generator origin used by /api/generate-sdk.
# Leave empty to default to the current web page origin seen by the serving API
# entrypoint, for example https://portal.example.com.
SDKWORK_CLOUDROUTER_TOOL_API_SDK_GENERATOR_BASE_URL=""

# Optional bearer token sent to the SDK generator when configured.
SDKWORK_CLOUDROUTER_TOOL_API_SDK_GENERATOR_API_KEY=""

# Optional directory of prebuilt SDK ZIP archives served by /api/generate-sdk.
# Expected file names use: <package-or-name-slug>-<language>-<version>.zip
# Standard pnpm.cmd build output and live generator fallback: dist/sdk-archives
# Examples:
# - sdkwork-cloudrouter-app-sdk-typescript-0.1.0.zip
# - sdkwork-cloudrouter-backend-sdk-typescript-0.1.0.zip
SDKWORK_CLOUDROUTER_TOOL_API_SDK_ARCHIVE_ROOT=""

# Additional HTTP/HTTPS origins allowed by production CSP connect-src.
# Runtime absolute API origins are added automatically; use this only for extra
# browser connection targets.
SDKWORK_CLOUDROUTER_EDGE_CSP_CONNECT_SRC=""

# Browser development proxy origins live in .env.development.example (SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_*).
# Do not use PORTAL_DEV_PROXY_* or PORTAL_PUBLIC_* in the development profile file.
