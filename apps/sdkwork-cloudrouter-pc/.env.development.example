# SDKWork Cloud Router browser development profile (.env.development).
# Copy to .env.development. Startup scripts merge generated defaults while
# preserving existing non-empty values. See specs/application-env-standard.md.
#
# Development uses VITE_* browser values and SDKWORK_CLOUDROUTER_ROUTER_* lifecycle metadata.
# PORTAL_PUBLIC_* belongs in .env.release only (release host /runtime-env.js).

# SDKWork application profile metadata.
SDKWORK_CLOUDROUTER_ROUTER_CONFIG_PROFILE=dev
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=development
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=browser

# Private bootstrap access credential for protected app-api/backend-api before login.
# The tracked placeholder stays blank. Workspace startup writes the live local-only
# value to gitignored .env.development.bootstrap.local.
SDKWORK_ACCESS_TOKEN=

# Private Vite dev-server proxy upstream origins (process-only, not browser-visible).
# Defaults to the integrated Rust edge server at http://127.0.0.1:3900.
# Upstream origin for /v1, /openapi.json, and OpenAI-compatible gateway routes.
SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_OPEN_API_ORIGIN=http://127.0.0.1:3900
# Upstream origin for /backend/v3/api admin SDK routes.
SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_BACKEND_API_ORIGIN=http://127.0.0.1:3900
# Upstream origin for /app/v3/api product SDK routes.
SDKWORK_CLOUDROUTER_BROWSER_DEV_PROXY_APP_API_ORIGIN=http://127.0.0.1:3900

# Browser-visible SDK base URLs (Vite-inlined in development).
# Production uses PORTAL_PUBLIC_* on the release host, mapped to VITE_* via /runtime-env.js.
# Public API reference and generic SDK root path.
VITE_API_BASE_URL=/v1
# @sdkwork/cloudrouter-open-sdk base URL.
VITE_CLOUDROUTER_OPEN_API_BASE_URL=/v1
# @sdkwork/cloudrouter-app-sdk base URL.
VITE_CLOUDROUTER_APP_API_BASE_URL=/app/v3/api
# @sdkwork/cloudrouter-backend-sdk base URL.
VITE_CLOUDROUTER_BACKEND_API_BASE_URL=/backend/v3/api
# @sdkwork/drive-admin-storage-sdk / drive backend base URL.
# Drive-owned surfaces (/backend/v3/api/drive/*) are served by the sdkwork-drive
# standalone gateway, not by the cloud-router backend. Match the value used by
# the drive app topology (SDKWORK_DRIVE_APPLICATION_PUBLIC_HTTP_URL).
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=http://127.0.0.1:3900

# Enables local browser tool UI (API reference codegen). Keep false for production-like dev.
# Browser gate for local tool/codegen routes.
VITE_TOOL_API_ENABLED=false

# Session auth handling when SDK/API returns 401 or session-expired business codes.
# - modal (default on localhost): show a dialog with error details; no forced redirect
# - redirect: clear session and navigate to /auth/login (production-like)
# - debug: keep the page and session untouched for investigation
# VITE_SDKWORK_SESSION_AUTH_UNAUTHORIZED_MODE=modal
#
# Canonical browser runtime env bag (all SDKWork PC apps):
# window.__SDKWORK_RUNTIME_ENV__ = { VITE_SDKWORK_SESSION_AUTH_UNAUTHORIZED_MODE: "modal" }
#
# Legacy alias (maps to debug mode):
# VITE_SDKWORK_CLOUDROUTER_DEV_SESSION_AUTH_REDIRECT_BYPASS=true
