        "action": "read",
        "status": "active",
        "since": "1.0.0",
        "replacementCode": null
      },
      {
        "code": "cloudrouter.gateway.manage",
        "name": "Manage gateway runtime and routing configuration",
        "resource": "gateway",
        "action": "manage",
        "status": "active",
        "since": "1.0.0",
        "replacementCode": null
      },
      {
        "code": "cloudrouter.system.read",
