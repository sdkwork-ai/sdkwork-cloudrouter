{
  "name": "@sdkwork/cloudrouter-pc-console-hardware",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../../../../LICENSE",
  "type": "module",
  "description": "SDKWork Cloud Router PC user-console Smart Hardware group: my devices, firmware downloads, and device-agent binding.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./contribution": {
      "types": "./src/contribution.ts",
      "import": "./src/contribution.ts",
      "default": "./src/contribution.ts"
    }
  },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "@sdkwork/aiot-pc-console-hardware": "workspace:*",
    "@sdkwork/cloudroutes-pc-commons": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0 <1.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "react-i18next": ">=17.0.0 <18.0.0",
    "react-router-dom": ">=7.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-cloudrouter",
    "architecture": "pc-console-react",
    "domain": "aiot",
