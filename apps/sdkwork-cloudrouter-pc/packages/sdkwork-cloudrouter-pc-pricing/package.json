    "react-i18next": ">=17.0.0 <18.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-cloudrouter",
    "architecture": "pc-react",
    "domain": "commerce",
    "capability": "pricing",
    "surface": "app",
    "status": "ready"
  }
