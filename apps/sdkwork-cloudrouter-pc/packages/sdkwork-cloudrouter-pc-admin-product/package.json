  "type": "module",
  "description": "SDKWork Cloud Router PC admin Product Center: catalog products, SKUs, categories, category attributes, brands, inventory, shipments and logistics, composed from the owning modules' backend SDKs.",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./contribution": {
      "types": "./src/contribution.ts",
      "import": "./src/contribution.ts",
      "default": "./src/contribution.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    }
  },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "@sdkwork/cloudroutes-pc-commons": "workspace:*",
    "sdkwork-drive-pc-upload-image": "workspace:*",
    "@sdkwork/inventory-backend-sdk": "workspace:*",
    "@sdkwork/order-backend-sdk": "workspace:*",
    "@sdkwork/shop-backend-sdk": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0 <1.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "react-i18next": ">=17.0.0 <18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-cloudrouter",
    "architecture": "pc-admin-react",
    "domain": "product",
    "capability": "product-center",
    "surface": "backend-admin",
    "status": "ready"
  }
