page {
  background-color: #f5f7fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.cr-card {
  background-color: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
}

.cr-muted {
  color: #64748b;
  font-size: 24rpx;
}

/* H5 dark appearance: the root page adds `theme-dark` from appearance.theme. */
.theme-dark {
  background: #0b1220;
  color: #f1f5f9;
}

.theme-dark.cr-home,
.theme-dark.cr-profile,
.theme-dark.cr-page,
.theme-dark.cr-bridge,
.theme-dark .cr-page {
  background: #0b1220;
}

.theme-dark .cr-primary,
.theme-dark .cr-card,
.theme-dark .cr-notice,
.theme-dark .cr-hero,
.theme-dark .cr-profile__card,
.theme-dark .cr-rows,
.theme-dark .cr-row,
.theme-dark .cr-head,
.theme-dark .cr-secret,
.theme-dark .cr-create-input,
.theme-dark .cr-more-button,
.theme-dark .cr-retry {
  background: #0f172a;
  border-color: #1e293b;
}

.theme-dark .cr-hero {
  color: #f1f5f9;
}

.theme-dark .cr-hero__title {
  color: #f1f5f9;
}

.theme-dark .cr-hero__search {
  background: #0b1220;
  border-color: #1e293b;
  color: #f1f5f9;
}

.theme-dark .cr-primary__icon {
  background: #1e293b;
}

.theme-dark .cr-primary__label,
.theme-dark .cr-service__label,
.theme-dark .cr-notice__text,
.theme-dark .cr-profile__subtitle,
.theme-dark .cr-row-sub,
.theme-dark .cr-more-button,
.theme-dark .cr-create-placeholder {
  color: #94a3b8;
}

.theme-dark .cr-card__title,
.theme-dark .cr-profile__name,
.theme-dark .cr-profile__label,
.theme-dark .cr-row-title,
.theme-dark .cr-row-tokens,
.theme-dark .cr-secret-value,
.theme-dark .cr-create-input {
  color: #f1f5f9;
}

.theme-dark .cr-profile__divider {
  background: #1e293b;
}

.theme-dark .cr-balance__divider {
  background: #1e293b;
}

.theme-dark .cr-balance__value {
  color: #f1f5f9;
}

.theme-dark .cr-balance__label,
.theme-dark .cr-profile__footer {
  color: #94a3b8;
}

.theme-dark .cr-profile__chevron,
.theme-dark .cr-notice__chevron {
  color: #64748b;
}

.theme-dark .cr-stats__label,
.theme-dark .cr-state-text {
  color: #94a3b8;
}

.theme-dark .cr-bridge__title {
  color: #f1f5f9;
}

.theme-dark .cr-bridge__desc {
  color: #94a3b8;
}

.theme-dark.sdk-settings {
  --sdk-settings-bg: #0b1220;
  --sdk-settings-panel: #0f172a;
  --sdk-settings-border: #1e293b;
  --sdk-settings-text: #f1f5f9;
  --sdk-settings-text-secondary: #94a3b8;
  --sdk-settings-brand: #38bdf8;
}
