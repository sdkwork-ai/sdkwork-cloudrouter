page {
  background: #f5f7fb;
}

.cr-home {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
}

.cr-hero {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  color: #0f172a;
  padding: 28rpx 28rpx 30rpx;
}

.cr-hero__badge {
  align-self: flex-start;
  background: #eff6ff;
  border-radius: 999rpx;
  color: #2563eb;
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
}

.cr-hero__title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 18rpx;
}

.cr-hero__accent {
  color: #2563eb;
}

.cr-hero__subtitle {
  color: #64748b;
  display: block;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.cr-hero__search {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  color: #0f172a;
  font-size: 26rpx;
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.cr-hero__search-placeholder {
  color: #94a3b8;
}

.cr-hero__actions {
  align-items: center;
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.cr-hero__button {
  background: #ffffff;
  border-radius: 14rpx;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
}

.cr-hero__link {
  color: #ffffff;
  font-size: 24rpx;
}

.cr-primary {
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 16rpx;
}

.cr-primary__item {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.cr-primary__icon {
  align-items: center;
  background: #eff6ff;
  border-radius: 20rpx;
  display: flex;
  font-size: 32rpx;
  height: 84rpx;
  justify-content: center;
  width: 84rpx;
}

.cr-primary__label {
  color: #475569;
  font-size: 22rpx;
}

.cr-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 26rpx 22rpx;
}

.cr-card__header {
  display: flex;
  justify-content: space-between;
}

.cr-card__title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
}

.cr-services {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.cr-service {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 0;
  width: 20%;
}

.cr-service__icon {
  font-size: 34rpx;
  line-height: 1.2;
}

.cr-service__label {
  color: #475569;
  font-size: 20rpx;
  text-align: center;
}

.cr-notice {
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
}

.cr-notice__tag {
  background: #eff6ff;
  border-radius: 8rpx;
  color: #1d4ed8;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
}

.cr-notice__text {
  color: #334155;
  flex: 1;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-notice__chevron {
  color: #94a3b8;
  font-size: 30rpx;
}

.cr-promo {
  align-items: center;
  background: #fff7ed;
  border-radius: 20rpx;
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
}

.cr-promo__icon {
  font-size: 32rpx;
}

.cr-promo__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.cr-promo__title {
  color: #9a3412;
  font-size: 26rpx;
  font-weight: 600;
}

.cr-promo__subtitle {
  color: #c2410c;
  font-size: 22rpx;
}

.cr-promo__chevron {
  color: #fb923c;
  font-size: 30rpx;
}

.cr-experience {
  align-items: center;
  background: #0f172a;
  border-radius: 24rpx;
  color: #ffffff;
  display: flex;
  margin-top: 16rpx;
  padding: 28rpx 26rpx;
}

.cr-experience__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.cr-experience__title {
  font-size: 30rpx;
  font-weight: 600;
}

.cr-experience__subtitle {
  color: #cbd5e1;
  font-size: 22rpx;
}

.cr-experience__arrow {
  color: #38bdf8;
  font-size: 36rpx;
}

.cr-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}

.cr-stats__item {
  align-items: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cr-stats__value {
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 700;
}

.cr-stats__label {
  color: #64748b;
  font-size: 20rpx;
}
