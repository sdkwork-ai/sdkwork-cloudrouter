/*
 * CloudRouter console overview (full-bleed per APP_MINI_PROGRAM_UI_SPEC §7:
 * no horizontal page padding; rhythm from vertical spacing and surface
 * contrast; inset tiles carry their own documented content inset).
 */

.cr-page {
  min-height: 100%;
  box-sizing: border-box;
  background: #0b1220;
  padding: 24rpx 0 48rpx;
}

.cr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 180rpx 48rpx;
}

.cr-state-text {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
}

.cr-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #1e293b;
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: cr-spin 0.9s linear infinite;
}

@keyframes cr-spin {
  to {
    transform: rotate(360deg);
  }
}

.cr-retry {
  margin: 0;
  padding: 14rpx 56rpx;
  background: #1e293b;
  color: #38bdf8;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 12rpx;
}

.cr-retry::after {
  border: none;
}

.cr-retry--hover {
  background: #334155;
}

.cr-window {
  padding: 16rpx 24rpx;
  background: #111c33;
  margin-bottom: 20rpx;
}

.cr-window-text {
  font-size: 22rpx;
  color: #7dd3fc;
}

.cr-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.cr-metric {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx 24rpx;
  background: #131c31;
  border-radius: 16rpx;
}

.cr-metric-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.cr-metric-value {
  font-size: 38rpx;
  font-weight: 600;
  color: #f1f5f9;
}
