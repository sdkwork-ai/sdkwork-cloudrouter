<view class="cr-page">
  <view wx:if="{{loading}}" class="cr-state">
    <view class="cr-spinner" />
    <text class="cr-state-text">{{labels.loading}}</text>
  </view>
  <view wx:elif="{{error}}" class="cr-state">
    <text class="cr-state-text">{{error}}</text>
    <button class="cr-retry" hover-class="cr-retry--hover" bindtap="onReload">{{labels.reload}}</button>
  </view>
  <view wx:elif="{{metrics.length === 0}}" class="cr-state">
    <text class="cr-state-text">{{labels.empty}}</text>
  </view>
  <block wx:else>
    <view wx:if="{{windowLabel}}" class="cr-window">
      <text class="cr-window-text">{{windowLabel}}</text>
    </view>
    <view class="cr-metrics">
      <view wx:for="{{metrics}}" wx:key="id" class="cr-metric">
        <text class="cr-metric-label">{{item.label}}</text>
        <text class="cr-metric-value">{{item.value}}</text>
      </view>
    </view>
  </block>
</view>
