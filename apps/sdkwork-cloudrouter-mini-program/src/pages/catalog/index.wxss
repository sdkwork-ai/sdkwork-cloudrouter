/*
 * CloudRouter console model & pricing catalog (full-bleed per
 * APP_MINI_PROGRAM_UI_SPEC §7: the header band and rows span the viewport
 * edge-to-edge with square corners; rows carry their own content inset).
 */

.cr-page {
  min-height: 100%;
  box-sizing: border-box;
  background: #0b1220;
  padding: 24rpx 0 48rpx;
}

.cr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 180rpx 48rpx;
}

.cr-state-text {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
}

.cr-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #1e293b;
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: cr-spin 0.9s linear infinite;
}

@keyframes cr-spin {
  to {
    transform: rotate(360deg);
  }
}

.cr-retry {
  margin: 0;
  padding: 14rpx 56rpx;
  background: #1e293b;
  color: #38bdf8;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 12rpx;
}

.cr-retry::after {
  border: none;
}

.cr-retry--hover {
  background: #334155;
}

.cr-head,
.cr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
}

.cr-head {
  background: #111c33;
}

.cr-rows {
  display: flex;
  flex-direction: column;
  background: #0f172a;
}

.cr-row {
  border-bottom: 1rpx solid #1e293b;
}

.cr-head text {
  font-size: 20rpx;
  color: #7dd3fc;
}

.cr-head-vendor,
.cr-row-vendor {
  width: 120rpx;
  flex-shrink: 0;
}

.cr-head-model,
.cr-row-model {
  flex: 1;
  min-width: 0;
}

.cr-head-price,
.cr-row-price {
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
}

.cr-row-vendor,
.cr-row-model,
.cr-row-price {
  font-size: 24rpx;
  color: #e2e8f0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-row-price {
  color: #cbd5e1;
}
