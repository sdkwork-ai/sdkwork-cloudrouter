<view class="cr-page">
  <view wx:if="{{loading}}" class="cr-state">
    <view class="cr-spinner" />
    <text class="cr-state-text">{{labels.loading}}</text>
  </view>
  <view wx:elif="{{error}}" class="cr-state">
    <text class="cr-state-text">{{error}}</text>
    <button class="cr-retry" hover-class="cr-retry--hover" bindtap="onReload">{{labels.reload}}</button>
  </view>
  <view wx:elif="{{rows.length === 0}}" class="cr-state">
    <text class="cr-state-text">{{labels.empty}}</text>
  </view>
  <block wx:else>
    <view class="cr-rows">
      <view wx:for="{{rows}}" wx:key="id" class="cr-row">
        <view class="cr-row-main">
          <text class="cr-row-title">{{item.model}}</text>
          <text class="cr-row-sub">{{item.time}} · {{item.status}}</text>
        </view>
        <view class="cr-row-side">
          <text class="cr-row-tokens">{{item.tokens}} {{labels.columnTokens}}</text>
          <text class="cr-row-cost">{{item.cost}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{hasMore}}" class="cr-more">
      <button class="cr-more-button" hover-class="cr-more-button--hover" disabled="{{loadingMore}}" bindtap="onLoadMore">
        {{loadingMore ? labels.loading : labels.loadMore}}
      </button>
    </view>
  </block>
</view>
