/*
 * CloudRouter console usage list (full-bleed per APP_MINI_PROGRAM_UI_SPEC §7:
 * rows span the viewport edge-to-edge with square corners; the row surface
 * carries its own documented content inset).
 */

.cr-page {
  min-height: 100%;
  box-sizing: border-box;
  background: #0b1220;
  padding: 24rpx 0 48rpx;
}

.cr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 180rpx 48rpx;
}

.cr-state-text {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
}

.cr-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #1e293b;
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: cr-spin 0.9s linear infinite;
}

@keyframes cr-spin {
  to {
    transform: rotate(360deg);
  }
}

.cr-retry {
  margin: 0;
  padding: 14rpx 56rpx;
  background: #1e293b;
  color: #38bdf8;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 12rpx;
}

.cr-retry::after {
  border: none;
}

.cr-retry--hover {
  background: #334155;
}

.cr-rows {
  display: flex;
  flex-direction: column;
  background: #0f172a;
}

.cr-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #1e293b;
}

.cr-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cr-row-title {
  font-size: 28rpx;
  color: #f1f5f9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-row-sub {
  font-size: 22rpx;
  color: #64748b;
}

.cr-row-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.cr-row-tokens {
  font-size: 24rpx;
  color: #cbd5e1;
}

.cr-row-cost {
  font-size: 24rpx;
  color: #38bdf8;
}

.cr-more {
  padding: 24rpx;
}

.cr-more-button {
  margin: 0;
  width: 100%;
  padding: 18rpx 0;
  background: #1e293b;
  color: #cbd5e1;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 12rpx;
}

.cr-more-button::after {
  border: none;
}

.cr-more-button--hover {
  background: #334155;
}

.cr-more-button[disabled] {
  color: #64748b;
}
