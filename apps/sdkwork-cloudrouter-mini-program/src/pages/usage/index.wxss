/*
 * CloudRouter console usage list (light theme, full-bleed per
 * APP_MINI_PROGRAM_UI_SPEC §7: rows span the viewport edge-to-edge with square
 * corners; the row surface carries its own documented content inset).
 */

.cr-page {
  min-height: 100%;
  box-sizing: border-box;
  background: #f5f7fb;
  padding: 24rpx 0 48rpx;
}

.cr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 180rpx 48rpx;
}

.cr-state-text {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
}

.cr-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: cr-spin 0.9s linear infinite;
}

@keyframes cr-spin {
  to {
    transform: rotate(360deg);
  }
}

.cr-retry {
  margin: 0;
  padding: 14rpx 56rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 12rpx;
}

.cr-retry::after {
  border: none;
}

.cr-retry--hover {
  background: #dbeafe;
}

.cr-rows {
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.cr-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.cr-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cr-row-title {
  font-size: 28rpx;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-row-sub {
  font-size: 22rpx;
  color: #64748b;
}

.cr-row-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.cr-row-tokens {
  font-size: 24rpx;
  color: #475569;
}

.cr-row-cost {
  font-size: 24rpx;
  color: #2563eb;
}

.cr-more {
  padding: 24rpx;
}

.cr-more-button {
  margin: 0;
  width: 100%;
  padding: 18rpx 0;
  background: #ffffff;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.6;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.cr-more-button::after {
  border: none;
}

.cr-more-button--hover {
  background: #f1f5f9;
}

.cr-more-button[disabled] {
  color: #94a3b8;
}
