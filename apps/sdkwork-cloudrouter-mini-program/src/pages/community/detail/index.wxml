<view class="cr-detail {{themeClass}}">
  <view wx:if="{{loading}}" class="cr-detail__state">加载中…</view>
  <view wx:elif="{{error}}" class="cr-detail__state">{{error}}</view>

  <block wx:else>
    <view class="cr-detail__cover">
      <image wx:if="{{circle.coverImage}}" src="{{circle.coverImage}}" mode="aspectFill" />
    </view>

    <view class="cr-detail__header">
      <view class="cr-detail__avatar">
        <image wx:if="{{circle.avatar}}" src="{{circle.avatar}}" mode="aspectFill" />
        <text wx:else>{{circle.name}}</text>
      </view>
      <view class="cr-detail__heading">
        <text class="cr-detail__title">{{circle.name}}</text>
        <text class="cr-detail__meta">{{circle.memberCount}} 成员 · {{circle.postCount}} 动态</text>
      </view>
      <button wx:if="{{!circle.isJoined}}" class="cr-detail__join" size="mini" bindtap="onJoin">
        {{circle.isPaid ? '¥' + circle.price + ' 加入' : '加入圈子'}}
      </button>
      <text wx:else class="cr-detail__joined">已加入</text>
    </view>

    <text class="cr-detail__desc">{{circle.description}}</text>

    <scroll-view class="cr-detail__tabs" scroll-x>
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="cr-detail__tab {{activeTab === item.id ? 'is-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTab"
      >{{item.label}}</view>
    </scroll-view>

    <block wx:if="{{activeTab === 'feed'}}">
      <view wx:if="{{posts.length === 0}}" class="cr-detail__state">暂无动态</view>
      <view wx:for="{{posts}}" wx:key="id" class="cr-post">
        <view class="cr-post__head">
          <text class="cr-post__author">{{item.authorName}}</text>
          <text wx:if="{{item.reviewState !== 'approved'}}" class="cr-post__pending">审核中</text>
        </view>
        <text class="cr-post__content">{{item.content}}</text>
        <view wx:if="{{item.images.length}}" class="cr-post__images">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" />
        </view>
        <view class="cr-post__actions">
          <text data-id="{{item.id}}" bindtap="onLike">赞 {{item.likes}}</text>
          <text data-id="{{item.id}}" bindtap="onOpenComments">评论 {{item.comments}}</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'resources'}}">
      <view wx:if="{{resources.length === 0}}" class="cr-detail__state">暂无资源</view>
      <view wx:for="{{resources}}" wx:key="id" class="cr-resource">
        <text class="cr-resource__title">{{item.content}}</text>
        <text class="cr-resource__meta">{{item.firstTag || 'link'}}</text>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'groups'}}">
      <view wx:if="{{groups.length === 0}}" class="cr-detail__state">暂无群组</view>
      <view wx:for="{{groups}}" wx:key="id" class="cr-group">
        <text class="cr-group__name">{{item.name}}</text>
        <text class="cr-group__meta">{{item.platform}} · {{item.memberCount}} 人 · {{item.qrCodeCount}} 个二维码</text>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'members'}}">
      <view wx:if="{{members.length === 0}}" class="cr-detail__state">暂无成员</view>
      <view wx:for="{{members}}" wx:key="id" class="cr-member">
        <text class="cr-member__name">{{item.name}}</text>
        <text class="cr-member__meta">{{item.role}} · {{item.status}}{{item.tierName ? ' · ' + item.tierName : ''}}</text>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'about'}}">
      <view class="cr-detail__about">
        <text>{{circle.description || '暂无简介'}}</text>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{tabPosts.length === 0}}" class="cr-detail__state">该标签页暂无内容</view>
      <view wx:for="{{tabPosts}}" wx:key="id" class="cr-post">
        <view class="cr-post__head">
          <text class="cr-post__author">{{item.authorName}}</text>
          <text wx:if="{{item.reviewState !== 'approved'}}" class="cr-post__pending">审核中</text>
        </view>
        <text class="cr-post__content">{{item.content}}</text>
        <view class="cr-post__actions">
          <text data-id="{{item.id}}" bindtap="onLike">赞 {{item.likes}}</text>
          <text data-id="{{item.id}}" bindtap="onOpenComments">评论 {{item.comments}}</text>
        </view>
      </view>
    </block>

    <view class="cr-detail__footer">
      <button class="cr-detail__manage" size="mini" bindtap="onManage">管理</button>
      <button class="cr-detail__full" size="mini" bindtap="onOpenFull">完整工作区</button>
    </view>

    <view wx:if="{{circle.isJoined}}" class="cr-detail__fab" bindtap="onCompose">＋</view>
  </block>

  <view wx:if="{{showComments}}" class="cr-comments">
    <view class="cr-comments__panel">
      <view class="cr-comments__head">
        <text>评论</text>
        <text class="cr-comments__close" bindtap="onCloseComments">关闭</text>
      </view>
      <scroll-view class="cr-comments__list" scroll-y>
        <view wx:if="{{commentsLoading}}" class="cr-detail__state">加载中…</view>
        <view wx:elif="{{comments.length === 0}}" class="cr-detail__state">暂无评论</view>
        <view wx:for="{{comments}}" wx:key="id" class="cr-comment">
          <text class="cr-comment__author">{{item.authorName}}</text>
          <text class="cr-comment__body">{{item.content}}</text>
        </view>
      </scroll-view>
      <view class="cr-comments__composer">
        <input value="{{commentText}}" placeholder="写评论…" bindinput="onCommentInput" />
        <button size="mini" bindtap="onSendComment">发送</button>
      </view>
    </view>
  </view>
</view>
