page {
  background: #f8fafc;
}

.cr-form {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cr-form.theme-dark {
  background: #0f172a;
}

.cr-form__input,
.cr-form__textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.cr-form__textarea {
  min-height: 320rpx;
}

.theme-dark .cr-form__input,
.theme-dark .cr-form__textarea {
  background: #1e293b;
  border-color: #334155;
  color: #e2e8f0;
}

.cr-form__submit {
  margin-top: 16rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.cr-form__hint {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.cr-form__error {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 24rpx;
}
