page {
  background: #f8fafc;
}

.cr-community {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  color: #0f172a;
}

.cr-community.theme-dark {
  background: #0f172a;
  color: #e2e8f0;
}

.cr-community__toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cr-community__search {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.theme-dark .cr-community__search {
  background: #1e293b;
  border-color: #334155;
  color: #e2e8f0;
}

.cr-community__full {
  font-size: 24rpx;
  color: #2563eb;
  white-space: nowrap;
}

.cr-community__scopes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cr-community__scope {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.cr-community__scope.is-active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}

.theme-dark .cr-community__scope {
  background: #1e293b;
  border-color: #334155;
  color: #cbd5e1;
}

.cr-community__card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.theme-dark .cr-community__card {
  background: #1e293b;
  border-color: #334155;
}

.cr-community__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #2563eb;
  flex-shrink: 0;
}

.cr-community__avatar image {
  width: 100%;
  height: 100%;
}

.cr-community__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cr-community__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cr-community__title {
  font-size: 30rpx;
  font-weight: 600;
}

.cr-community__badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #15803d;
  font-size: 20rpx;
}

.cr-community__desc {
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-community__meta {
  font-size: 22rpx;
  color: #94a3b8;
}

.cr-community__join {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 24rpx;
}

.cr-community__state {
  padding: 80rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.cr-community__fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #2563eb;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(37, 99, 235, 0.35);
}
