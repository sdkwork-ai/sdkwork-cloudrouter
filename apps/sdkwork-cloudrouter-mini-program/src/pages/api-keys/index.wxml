<view class="cr-page">
  <view wx:if="{{createdSecret}}" class="cr-secret">
    <text class="cr-secret-title">{{labels.createdOnce}}</text>
    <text class="cr-secret-value" user-select="{{true}}">{{createdSecret}}</text>
  </view>

  <view class="cr-create">
    <input
      class="cr-create-input"
      placeholder="{{labels.namePlaceholder}}"
      placeholder-class="cr-create-placeholder"
      value="{{draftName}}"
      confirm-type="done"
      bindinput="onDraftName"
      bindconfirm="onCreate"
    />
    <button
      class="cr-create-button"
      hover-class="cr-create-button--hover"
      disabled="{{submitting || !draftName}}"
      bindtap="onCreate"
    >
      {{submitting ? labels.creating : labels.create}}
    </button>
  </view>

  <view wx:if="{{loading}}" class="cr-state">
    <view class="cr-spinner" />
    <text class="cr-state-text">{{labels.loading}}</text>
  </view>
  <view wx:elif="{{error}}" class="cr-state">
    <text class="cr-state-text">{{error}}</text>
    <button class="cr-retry" hover-class="cr-retry--hover" bindtap="onReload">{{labels.reload}}</button>
  </view>
  <view wx:elif="{{rows.length === 0}}" class="cr-state">
    <text class="cr-state-text">{{labels.empty}}</text>
  </view>
  <block wx:else>
    <view class="cr-rows">
      <view wx:for="{{rows}}" wx:key="id" class="cr-row">
        <view class="cr-row-main">
          <text class="cr-row-title">{{item.name}}</text>
          <text class="cr-row-sub">{{item.maskedKey}} · {{item.createdAt}}</text>
        </view>
        <view class="cr-row-side">
          <text class="cr-row-status {{item.revoked ? 'cr-row-status--off' : 'cr-row-status--on'}}">{{item.status}}</text>
          <button
            wx:if="{{!item.revoked}}"
            class="cr-row-revoke"
            hover-class="cr-row-revoke--hover"
            data-id="{{item.id}}"
            bindtap="onRevoke"
          >
            {{labels.revoke}}
          </button>
        </view>
      </view>
    </view>
  </block>
</view>
