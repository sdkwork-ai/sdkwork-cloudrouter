/*
 * CloudRouter console API keys (light theme, full-bleed per
 * APP_MINI_PROGRAM_UI_SPEC §7: the create band and the list rows span the
 * viewport edge-to-edge; each surface carries its own content inset).
 */

.cr-page {
  min-height: 100%;
  box-sizing: border-box;
  background: #f5f7fb;
  padding: 24rpx 0 48rpx;
}

.cr-secret {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 16rpx;
}

.cr-secret-title {
  font-size: 22rpx;
  color: #1d4ed8;
}

.cr-secret-value {
  font-size: 26rpx;
  color: #0f172a;
  word-break: break-all;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
}

.cr-create {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.cr-create-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.cr-create-placeholder {
  color: #94a3b8;
}

.cr-create-button {
  margin: 0;
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.cr-create-button::after {
  border: none;
}

.cr-create-button--hover {
  background: #1d4ed8;
}

.cr-create-button[disabled] {
  background: #e2e8f0;
  color: #94a3b8;
}

.cr-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  padding: 120rpx 48rpx;
}

.cr-state-text {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
}

.cr-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: cr-spin 0.9s linear infinite;
}

@keyframes cr-spin {
  to {
    transform: rotate(360deg);
  }
}

.cr-retry {
  margin: 0;
  padding: 14rpx 56rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 12rpx;
}

.cr-retry::after {
  border: none;
}

.cr-retry--hover {
  background: #dbeafe;
}

.cr-rows {
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.cr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.cr-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cr-row-title {
  font-size: 28rpx;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr-row-sub {
  font-size: 22rpx;
  color: #64748b;
  word-break: break-all;
}

.cr-row-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.cr-row-status {
  font-size: 22rpx;
}

.cr-row-status--on {
  color: #16a34a;
}

.cr-row-status--off {
  color: #94a3b8;
}

.cr-row-revoke {
  margin: 0;
  padding: 8rpx 28rpx;
  background: transparent;
  border: 1rpx solid #fecaca;
  color: #b91c1c;
  font-size: 22rpx;
  line-height: 1.6;
  border-radius: 10rpx;
}

.cr-row-revoke::after {
  border: none;
}

.cr-row-revoke--hover {
  background: #fef2f2;
}
