{
  "schemaVersion": 1,
  "kind": "sdkwork.app.store-publishing",
  "marketId": "GOOGLE_PLAY",
  "displayName": "Google Play",
  "enabled": true,
  "platforms": ["android"],
  "regions": {
    "unitedStates": true,
    "chinaMainland": false,
    "note": "Google Play does not distribute in mainland China; the China Android lane is owned by the Huawei AppGallery configuration."
  },
  "identifiers": {
    "applicationId": "com.sdkwork.cloudrouter.mobile",
    "track": "production"
  },
  "listing": {
    "defaultLocale": "en-US",
    "locales": {
      "en-US": {
        "name": "SDKWork CloudRouter",
        "shortDescription": "Models and compute, one app",
        "description": "Track membership and Token Bank compute credits, manage model routing and API keys, review usage and billing, and chat with AI assistants from the SDKWork CloudRouter mobile app.",
        "keywords": ["cloud compute", "model routing", "token", "ai", "api keys"]
      },
      "zh-CN": {
        "name": "SDKWork CloudRouter",
        "shortDescription": "算力与模型，一站式上云",
        "description": "在 SDKWork CloudRouter 移动端查看会员与 Token Bank 算力额度、管理模型路由与 API 密钥、掌握用量与账单，并与 AI 助手对话。",
        "keywords": ["云算力", "模型路由", "Token", "AI", "API 密钥"]
      }
    },
    "categories": {
      "primary": "PRODUCTIVITY",
      "secondary": "TOOLS"
    },
    "supportUrl": "https://sdkwork.com/support",
    "privacyPolicyUrl": "https://sdkwork.com/privacy",
    "marketingUrl": "https://sdkwork.com/apps/sdkwork-cloudrouter"
  },
  "release": {
    "track": "PRODUCTION",
    "releaseType": "STAGED_ROLLOUT",
    "phasedRelease": true,
    "rolloutPercent": 25,
    "countries": ["US", "CA", "GB", "DE", "FR", "JP", "SG", "AU", "IN", "BR"],
    "minSupportedVersion": "0.1.0"
  },
  "submission": {
    "mode": "automated",
    "transport": "google-play-developer-api",
    "credentialRefs": {
      "serviceAccount": "env:SDKWORK_GOOGLE_PLAY_SERVICE_ACCOUNT"
    },
    "targets": [
      {
        "id": "android",
        "platform": "android",
        "packageFormat": "AAB",
        "artifactName": "android.aab"
      }
    ]
  },
  "media": {
    "icon": "assets/media/store/icons/google/play-icon-512.png",
    "featureGraphic": "assets/media/store/google/feature-graphic-1024x500.png",
    "screenshots": [
      {
        "root": "assets/media/store/screenshots/android",
        "platform": "APP_ANDROID",
        "deviceClass": "ANDROID_PHONE",
        "displayType": "ANDROID_PHONE"
      }
    ]
  },
  "storeUrl": "https://play.google.com/store/apps/details?id=com.sdkwork.cloudrouter.mobile"
