  "identifiers": {
    "bundleId": "com.sdkwork.cloudrouter.mobile",
    "sku": "CLOUDROUTER-FLUTTER-MOBILE",
    "appleId": null
  },
  "listing": {
    "defaultLocale": "zh-CN",
    "locales": {
      "zh-CN": {
        "name": "SDKWork CloudRouter",
        "subtitle": "算力与模型，一站式上云",
        "description": "SDKWork CloudRouter 移动端：查看会员与 Token Bank 算力额度、管理模型路由与 API 密钥、随时掌握用量与账单，并与 AI 助手对话。",
        "keywords": ["云算力", "模型路由", "Token", "AI", "API 密钥"]
      },
      "en-US": {
        "name": "SDKWork CloudRouter",
        "subtitle": "Models and compute, one app",
        "description": "SDKWork CloudRouter mobile: track membership and Token Bank compute credits, manage model routing and API keys, review usage and billing, and chat with AI assistants.",
        "keywords": ["cloud compute", "model routing", "token", "ai", "api keys"]
      }
    },
    "categories": {
      "primary": "PRODUCTIVITY",
      "secondary": "DEVELOPER_TOOLS"
    },
    "supportUrl": "https://sdkwork.com/support",
    "privacyPolicyUrl": "https://sdkwork.com/privacy",
    "marketingUrl": "https://sdkwork.com/apps/sdkwork-cloudrouter",
    "copyright": "SDKWork"
  },
  "release": {
    "track": "APP_STORE",
    "releaseType": "MANUAL",
    "phasedRelease": false,
    "rolloutPercent": 100,
