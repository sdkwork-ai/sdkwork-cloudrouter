      "issuerId": "env:SDKWORK_APPLE_ISSUER_ID",
      "privateKey": "env:SDKWORK_APPLE_PRIVATE_KEY"
    },
    "targets": [
      {
        "id": "ios",
        "platform": "ios",
        "packageFormat": "IPA",
        "artifactName": "ios.ipa"
      }
    ]
  },
  "media": {
    "icon": "assets/media/store/icons/apple/app-icon-1024.png",
    "screenshots": [
      {
        "root": "assets/media/store/screenshots/ios",
        "platform": "APP_IOS",
        "deviceClass": "IPHONE",
        "displayType": "IPHONE_6_9"
      }
    ]
