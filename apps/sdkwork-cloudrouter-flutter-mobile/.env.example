# Flutter mobile runtime env is delivered through --dart-define, materialized
# from env/sdkwork.<deploymentProfile>.<environment>.json.
SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.development
SDKWORK_RUNTIME_TARGET=flutter-android
SDKWORK_CLOUDROUTER_ROUTER_APP_API_BASE_URL=http://127.0.0.1:3905/app/v3/api
