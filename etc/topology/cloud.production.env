# cloud.production
# Cloud-hosted container profile: the edge terminates the public host and the
# platform API gateway is the shared dependency plane.
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=container
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=production
SDKWORK_CLOUDROUTER_ROUTER_PROFILE_ID=cloud.production
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_ENVIRONMENT=production
SDKWORK_CORS_ALLOWED_ORIGINS=https://router.sdkwork.com,https://cloudrouter.sdkwork.com,https://router.birdcoder.com,https://router.dtupay.com,https://router.noaper.com,https://router.sdkwork.cn,https://router.birdcoder.cn,https://router.dtupay.cn,https://router.noaper.cn,https://router.skubc.com,https://router.skubc.cn,https://router.zowalk.com,https://router.zowalk.cn,https://router.offer86.com,https://router.offer86.cn,https://router.86offer.com,https://router.86offer.cn,https://router-admin.sdkwork.com,https://router-admin.birdcoder.com,https://router-admin.dtupay.com,https://router-admin.noaper.com,https://router-admin.sdkwork.cn,https://router-admin.birdcoder.cn,https://router-admin.dtupay.cn,https://router-admin.noaper.cn,https://router-admin.skubc.com,https://router-admin.skubc.cn,https://router-admin.zowalk.com,https://router-admin.zowalk.cn,https://router-admin.offer86.com,https://router-admin.offer86.cn,https://router-admin.86offer.com,https://router-admin.86offer.cn,https://router-open.sdkwork.com,https://router-open.birdcoder.com,https://router-open.dtupay.com,https://router-open.noaper.com,https://router-open.sdkwork.cn,https://router-open.birdcoder.cn,https://router-open.dtupay.cn,https://router-open.noaper.cn,https://router-open.skubc.com,https://router-open.skubc.cn,https://router-open.zowalk.com,https://router-open.zowalk.cn,https://router-open.offer86.com,https://router-open.offer86.cn,https://router-open.86offer.com,https://router-open.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_PROFILE_ID=cloud.production
SDKWORK_CLOUDROUTER_STARTUP_INSTALL_MODE=skip

SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3900
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://router.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:18080
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=https://router.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:18081
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://router.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_APP_API_BIND=127.0.0.1:18082
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND=127.0.0.1:3901
SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Embedded RTC backend surface hydrate scope (BIGINT tenant ids; app identity tenantId 100001).
SDKWORK_RTC_HYDRATE_TENANT_ID=100001
SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=0

# Federated sdkwork-feeds open surface (API_ASSEMBLY_SPEC §6.1.1 same-origin).
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001

VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://router.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://router.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=https://router.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Drive-owned backend surface base URL (sdkwork-drive standalone gateway).
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=https://drive.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CLOUDROUTER_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CLOUDROUTER_ENVIRONMENT=production
SDKWORK_CLOUDROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_CLOUDROUTER_PROFILE_ID=cloud.production
