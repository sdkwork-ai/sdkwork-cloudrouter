# standalone.development
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=server
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=development
SDKWORK_CLOUDROUTER_ROUTER_PROFILE_ID=standalone.development
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=development
SDKWORK_PROFILE_ID=standalone.development


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CLOUDROUTER_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3905
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3905
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:18080
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18080
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:18081
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_APP_API_BIND=127.0.0.1:18082
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND=127.0.0.1:3901

SDKWORK_CLOUDROUTER_REDIS_ENABLED=true
SDKWORK_CLOUDROUTER_REDIS_HOST=127.0.0.1
SDKWORK_CLOUDROUTER_REDIS_PORT=6379
SDKWORK_CLOUDROUTER_REDIS_DATABASE=0
SDKWORK_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter
SDKWORK_CLOUDROUTER_REDIS_TLS=false
SDKWORK_CLOUDROUTER_REDIS_MAX_CONNECTIONS=16
SDKWORK_CLOUDROUTER_REDIS_CONNECT_TIMEOUT_MILLIS=2000
SDKWORK_CLOUDROUTER_REDIS_COMMAND_TIMEOUT_MILLIS=1000
SDKWORK_CLOUDROUTER_REDIS_POOL_IDLE_TIMEOUT_SECONDS=60

# Embedded RTC backend surface hydrate scope. Tenant ids are BIGINT in the
# RTC PostgreSQL schema, so the scope must be numeric (app identity
# tenantId 100001 / organizationId 0); the assembly hydrates at startup.
SDKWORK_RTC_HYDRATE_TENANT_ID=100001
SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=0

# Federated sdkwork-feeds open surface (API_ASSEMBLY_SPEC §6.1.1 same-origin).
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001

VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3905
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:18081
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:18080

# Drive-owned backend surface base URL (mounted on the Cloud Router backend edge).
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=/backend/v3/api

# Collapsed standalone: community commerce integrations call in-process
# membership/order backend surfaces on the same Cloud Router gateway origin.
SDKWORK_MEMBERSHIP_BACKEND_API_BASE_URL=http://127.0.0.1:3905/backend/v3/api
SDKWORK_ORDER_BACKEND_API_BASE_URL=http://127.0.0.1:3905/backend/v3/api
VITE_SDKWORK_MEMBERSHIP_BACKEND_API_BASE_URL=/backend/v3/api
# @sdkwork/feeds-sdk open surface (same-origin federated dependency).
VITE_SDKWORK_FEEDS_OPEN_API_BASE_URL=/feeds/v3/api
