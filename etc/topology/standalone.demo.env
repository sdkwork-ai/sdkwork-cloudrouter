# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated demo PostgreSQL schema/database `sdkwork_cloudrouter_demo` (DB identity).
# Redis isolation: any cache/rate-limit keys use a dedicated logical DB index so no key collides
# with another shared-redis environment. This profile declares no concrete redis/database env keys;
# provisioning must assign them before activation.
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=server
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=demo
SDKWORK_CLOUDROUTER_ROUTER_PROFILE_ID=standalone.demo
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_ENVIRONMENT=demo
SDKWORK_CORS_ALLOWED_ORIGINS=https://router-demo.sdkwork.com,http://router-demo.sdkwork.com,https://cloudrouter-demo.sdkwork.com,http://cloudrouter-demo.sdkwork.com,https://router-demo.birdcoder.com,http://router-demo.birdcoder.com,https://router-demo.dtupay.com,http://router-demo.dtupay.com,https://router-demo.noaper.com,http://router-demo.noaper.com,https://router-demo.sdkwork.cn,http://router-demo.sdkwork.cn,https://router-demo.birdcoder.cn,http://router-demo.birdcoder.cn,https://router-demo.dtupay.cn,http://router-demo.dtupay.cn,https://router-demo.noaper.cn,http://router-demo.noaper.cn,https://router-demo.skubc.com,http://router-demo.skubc.com,https://router-demo.skubc.cn,http://router-demo.skubc.cn,https://router-demo.zowalk.com,http://router-demo.zowalk.com,https://router-demo.zowalk.cn,http://router-demo.zowalk.cn,https://router-demo.offer86.com,http://router-demo.offer86.com,https://router-demo.offer86.cn,http://router-demo.offer86.cn,https://router-demo.86offer.com,http://router-demo.86offer.com,https://router-demo.86offer.cn,http://router-demo.86offer.cn,https://router-admin-demo.sdkwork.com,http://router-admin-demo.sdkwork.com,https://router-admin-demo.birdcoder.com,http://router-admin-demo.birdcoder.com,https://router-admin-demo.dtupay.com,http://router-admin-demo.dtupay.com,https://router-admin-demo.noaper.com,http://router-admin-demo.noaper.com,https://router-admin-demo.sdkwork.cn,http://router-admin-demo.sdkwork.cn,https://router-admin-demo.birdcoder.cn,http://router-admin-demo.birdcoder.cn,https://router-admin-demo.dtupay.cn,http://router-admin-demo.dtupay.cn,https://router-admin-demo.noaper.cn,http://router-admin-demo.noaper.cn,https://router-admin-demo.skubc.com,http://router-admin-demo.skubc.com,https://router-admin-demo.skubc.cn,http://router-admin-demo.skubc.cn,https://router-admin-demo.zowalk.com,http://router-admin-demo.zowalk.com,https://router-admin-demo.zowalk.cn,http://router-admin-demo.zowalk.cn,https://router-admin-demo.offer86.com,http://router-admin-demo.offer86.com,https://router-admin-demo.offer86.cn,http://router-admin-demo.offer86.cn,https://router-admin-demo.86offer.com,http://router-admin-demo.86offer.com,https://router-admin-demo.86offer.cn,http://router-admin-demo.86offer.cn,https://router-open-demo.sdkwork.com,http://router-open-demo.sdkwork.com,https://router-open-demo.birdcoder.com,http://router-open-demo.birdcoder.com,https://router-open-demo.dtupay.com,http://router-open-demo.dtupay.com,https://router-open-demo.noaper.com,http://router-open-demo.noaper.com,https://router-open-demo.sdkwork.cn,http://router-open-demo.sdkwork.cn,https://router-open-demo.birdcoder.cn,http://router-open-demo.birdcoder.cn,https://router-open-demo.dtupay.cn,http://router-open-demo.dtupay.cn,https://router-open-demo.noaper.cn,http://router-open-demo.noaper.cn,https://router-open-demo.skubc.com,http://router-open-demo.skubc.com,https://router-open-demo.skubc.cn,http://router-open-demo.skubc.cn,https://router-open-demo.zowalk.com,http://router-open-demo.zowalk.com,https://router-open-demo.zowalk.cn,http://router-open-demo.zowalk.cn,https://router-open-demo.offer86.com,http://router-open-demo.offer86.com,https://router-open-demo.offer86.cn,http://router-open-demo.offer86.cn,https://router-open-demo.86offer.com,http://router-open-demo.86offer.com,https://router-open-demo.86offer.cn,http://router-open-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_ENV=demo
SDKWORK_PROFILE_ID=standalone.demo
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://router-demo.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:18080
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=https://router-demo.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:18081
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://router-demo.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_APP_API_BIND=127.0.0.1:18082
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND=127.0.0.1:3901

# Embedded RTC backend surface hydrate scope (BIGINT tenant ids; app identity tenantId 100001).
SDKWORK_RTC_HYDRATE_TENANT_ID=100001
SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=0

# Federated sdkwork-feeds open surface (API_ASSEMBLY_SPEC §6.1.1 same-origin).
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001

VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://router-demo.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://router-demo.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=https://router-demo.sdkwork.com

# Drive-owned backend surface base URL.
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=https://drive-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CLOUDROUTER_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CLOUDROUTER_ENVIRONMENT=demo
SDKWORK_CLOUDROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLOUDROUTER_PROFILE_ID=standalone.demo
