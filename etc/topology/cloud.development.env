SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC §3).
# The domain edge above stays authoritative for cloud-mode builds and deployed
# services. The vite dev surface instead binds every platform gateway / router
# application base URL to the sdkwork-api-cloud-gateway started by `pnpm dev`
# in sdkwork-api-cloud-gateway (bind 127.0.0.1:3900), so `pnpm dev:cloud` can
# quick-start and debug against the local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900

# Embedded RTC backend surface hydrate scope (BIGINT tenant ids; app identity tenantId 100001).
SDKWORK_RTC_HYDRATE_TENANT_ID=100001
SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=0

# Federated sdkwork-feeds open surface (API_ASSEMBLY_SPEC §6.1.1 same-origin).
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001

VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://router-dev.sdkwork.com:3905
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=http://router-dev.sdkwork.com:3905
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=http://router-dev.sdkwork.com:3905
VITE_SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

# Drive-owned backend surface base URL (sdkwork-drive standalone gateway).
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=http://drive-dev.sdkwork.com:3900

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CLOUDROUTER_ENVIRONMENT=development
SDKWORK_CLOUDROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_CLOUDROUTER_PROFILE_ID=cloud.development
