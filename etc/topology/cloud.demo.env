# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated demo PostgreSQL schema/database `sdkwork_cloudrouter_demo` (DB identity).
# Redis isolation: any cache/rate-limit keys use a dedicated logical DB index so no key collides
# with another shared-redis environment. This profile declares no concrete redis/database env keys;
# provisioning must assign them before activation.
SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_CLOUDROUTER_ROUTER_RUNTIME_TARGET=container
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=demo
SDKWORK_CLOUDROUTER_ROUTER_PROFILE_ID=cloud.demo
SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PROFILE_ID=cloud.demo
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3900
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://router-demo.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:18080
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=https://router-demo.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:18081
SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://router-demo.sdkwork.com
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_APP_API_BIND=127.0.0.1:18082
SDKWORK_CLOUDROUTER_ROUTER_INTERNAL_PORTAL_RENDERER_BIND=127.0.0.1:3901
SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Embedded RTC backend surface hydrate scope (BIGINT tenant ids; app identity tenantId 100001).
SDKWORK_RTC_HYDRATE_TENANT_ID=100001
SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=0

# Federated sdkwork-feeds open surface (API_ASSEMBLY_SPEC §6.1.1 same-origin).
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001

VITE_SDKWORK_CLOUDROUTER_ROUTER_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://router-demo.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://router-demo.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_APPLICATION_OPEN_HTTP_URL=https://router-demo.sdkwork.com
VITE_SDKWORK_CLOUDROUTER_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Drive-owned backend surface base URL.
VITE_SDKWORK_DRIVE_BACKEND_API_BASE_URL=https://drive-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CLOUDROUTER_ROUTER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_CLOUDROUTER_ENVIRONMENT=demo
SDKWORK_CLOUDROUTER_DEPLOYMENT_PROFILE=cloud
SDKWORK_CLOUDROUTER_PROFILE_ID=cloud.demo
