# sdkwork-cloudrouter production deployment inputs (deployments/docker/bundle/env uses the same template).
# Copy to production.env and fill the placeholders before exposing beyond localhost.

# Release identity (RELEASE_SPEC.md §3): the image tag this environment runs.
SDKWORK_CLOUDROUTER_IMAGE_TAG=0.4.0

# Fleet topology.
SDKWORK_CLOUDROUTER_REPLICAS=1
SDKWORK_CLOUDROUTER_PROD_HOST_PORT=3953
SDKWORK_CLOUDROUTER_DEPS_MODE=external

# Database (external host-system PostgreSQL by default; embedded mode reads
# CLOUDROUTER_POSTGRES_PASSWORD from the bundle env file instead).
SDKWORK_DATABASE_HOST=host.docker.internal
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD=<CHANGE_ME>
SDKWORK_DATABASE_SSL_MODE=disable

# Redis (external host-system Redis by default).
SDKWORK_CLOUDROUTER_REDIS_HOST=host.docker.internal
SDKWORK_CLOUDROUTER_REDIS_PORT=6379
SDKWORK_CLOUDROUTER_REDIS_DATABASE=0
SDKWORK_CLOUDROUTER_REDIS_PASSWORD=

# Observability floor (OPERATIONS_SPEC.md §2.1): DEBUG is development/test only.
RUST_LOG=info
