# Alert delivery for the Cloud Router edge credential-entry channel.
# Install as /etc/sdkwork/alerting.env (root:root, mode 0600).
#
# Every edge alert is written to journald unconditionally
# (`journalctl -p crit -t sdkwork-cloudrouter-bootstrap`). When a webhook is set
# here, the same message is POSTed as:
#   {"service":"sdkwork-cloudrouter","level":"critical","title":"...","detail":"..."}
# Point it at whatever the on-call rotation already watches (IM bot, Lark/Feishu
# robot, Slack/PagerDuty relay). Leaving it empty keeps journald-only behaviour.
SDKWORK_ALERT_WEBHOOK_URL=
