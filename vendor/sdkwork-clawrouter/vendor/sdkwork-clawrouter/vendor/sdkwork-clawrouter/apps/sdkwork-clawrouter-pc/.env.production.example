# SDKWork Claw Router browser production profile (.env.production).
# Copy to .env.production before portal production build. Startup/build scripts
# merge generated defaults while preserving existing non-empty values.
# See specs/application-env-standard.md.

SDKWORK_CLAW_CONFIG_PROFILE=prod
SDKWORK_CLAW_ENVIRONMENT=production
SDKWORK_CLAW_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLAW_RUNTIME_TARGET=browser

# Private bootstrap access credential for local production preview and tooling.
# Production portal bundles must not embed this value; Vite only injects it in
# development mode. Do not commit live values.
SDKWORK_ACCESS_TOKEN=
