[Unit]
Description=SDKWork Claw Router Edge Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sdkwork
Group=sdkwork
Environment=SDKWORK_CLAW_DEPLOYMENT_MODE=server
Environment=SDKWORK_CLAW_CONFIG_FILE=/etc/sdkwork/clawrouter.toml
ExecStart=/usr/local/bin/sdkwork-clawrouter-standalone-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
