{
  "schemaVersion": 1,
  "kind": "sdkwork.rpc.manifest",
  "domain": "commerce",
  "sdkFamily": "sdkwork-commerce-rpc-sdk",
  "discoveryServiceName": "sdkwork-commerce-app-rpc",
  "defaultResilienceProfile": "rpc-default",
  "services": [
    {
      "package": "sdkwork.commerce.app.v3",
      "service": "WalletService",
      "surface": "app",
      "methods": [
        { "method": "RetrieveWalletOverview", "operationId": "wallet.overview.retrieve", "auth": "dual-token", "idempotency": "none", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" },
        { "method": "ListWalletAccounts", "operationId": "wallet.accounts.list", "auth": "dual-token", "idempotency": "none", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" },
        { "method": "ListWalletLedgerEntries", "operationId": "wallet.ledgerEntries.list", "auth": "dual-token", "idempotency": "none", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" }
      ]
    },
    {
      "package": "sdkwork.commerce.app.v3",
      "service": "CheckoutService",
      "surface": "app",
      "methods": [
        { "method": "CreateCheckoutSession", "operationId": "checkout.sessions.create", "auth": "dual-token", "idempotency": "required", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" },
        { "method": "RetrieveCheckoutSession", "operationId": "checkout.sessions.retrieve", "auth": "dual-token", "idempotency": "none", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" },
        { "method": "CreateCheckoutQuote", "operationId": "checkout.sessions.quotes.create", "auth": "dual-token", "idempotency": "required", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" },
        { "method": "CreateCheckoutOrder", "operationId": "checkout.sessions.orders.create", "auth": "dual-token", "idempotency": "required", "streaming": "unary", "owner": "commerce-open-api", "compatibility": "v3" }
      ]
    },
    {
      "package": "sdkwork.commerce.backend.v3",
      "service": "PaymentAdminService",
      "surface": "backend",
      "methods": [
        { "method": "ListPaymentProviderAccounts", "operationId": "payments.providerAccounts.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "CreatePaymentProviderAccount", "operationId": "payments.providerAccounts.create", "auth": "backend-admin", "idempotency": "required", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListPaymentMethods", "operationId": "payments.methods.management.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListPaymentChannels", "operationId": "payments.channels.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListPaymentIntents", "operationId": "payments.intents.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListPaymentAttempts", "operationId": "payments.attempts.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListPaymentReconciliationRuns", "operationId": "payments.reconciliationRuns.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" }
      ]
    },
    {
      "package": "sdkwork.commerce.backend.v3",
      "service": "CommerceReportService",
      "surface": "backend",
      "methods": [
        { "method": "ListUsageStatements", "operationId": "commerceReports.usageStatements.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "RetrievePaymentReconciliation", "operationId": "commerceReports.paymentReconciliation.retrieve", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListOrderRevenue", "operationId": "commerceReports.orderRevenue.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" },
        { "method": "ListRefundReports", "operationId": "commerceReports.refunds.list", "auth": "backend-admin", "idempotency": "none", "streaming": "unary", "owner": "commerce-backend-api", "compatibility": "v3" }
      ]
    }
  ]
}
