{
  "name": "@sdkwork/commerce-pc-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork Commerce PC application composition root.",
  "scripts": {
    "dev": "node ../../../sdkwork-iam/scripts/dev/run-pc-renderer-dev-with-bootstrap.mjs -- vite --host 127.0.0.1 --port 5174",
    "dev:server": "node -e \"console.log('Commerce PC server development profile: apps/sdkwork-commerce-pc/config/server/sdkwork-commerce-pc.development.toml.example')\"",
    "build": "vite build",
    "build:staging": "node scripts/validate-runtime-config.mjs --profile staging && vite build --mode staging",
    "build:prod": "node scripts/validate-runtime-config.mjs --profile production && vite build --mode production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. run test:vitest",
    "test:config": "node --test ../../sdks/test/verify-commerce-standard-architecture.test.mjs && node scripts/validate-runtime-config.mjs --all",
    "lint": "pnpm run typecheck"
  },
  "dependencies": {
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/appbase-pc-react": "workspace:*",
    "@sdkwork/auth-pc-react": "workspace:*",
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/commerce-runtime": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/iam-runtime": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*",
    "sdkwork-commerce-app-sdk-generated-typescript": "workspace:*",
    "sdkwork-commerce-backend-sdk-generated-typescript": "workspace:*",
    "@sdkwork/commerce-pc-admin-core": "workspace:*",
    "@sdkwork/commerce-pc-admin-membership": "workspace:*",
    "@sdkwork/commerce-pc-admin-product": "workspace:*",
    "@sdkwork/commerce-pc-admin-shell": "workspace:*",
    "@sdkwork/commerce-pc-billing": "workspace:*",
    "@sdkwork/commerce-pc-checkout": "workspace:*",
    "@sdkwork/commerce-pc-commons": "workspace:*",
    "@sdkwork/commerce-pc-commerce": "workspace:*",
    "@sdkwork/commerce-pc-core": "workspace:*",
    "@sdkwork/commerce-pc-coupon": "workspace:*",
    "@sdkwork/commerce-pc-entitlement": "workspace:*",
    "@sdkwork/commerce-pc-invoice": "workspace:*",
    "@sdkwork/commerce-pc-membership": "workspace:*",
    "@sdkwork/commerce-pc-membership-purchase": "workspace:*",
    "@sdkwork/commerce-pc-offer": "workspace:*",
    "@sdkwork/commerce-pc-order": "workspace:*",
    "@sdkwork/commerce-pc-payment": "workspace:*",
    "@sdkwork/commerce-pc-points": "workspace:*",
    "@sdkwork/commerce-pc-pricing": "workspace:*",
    "@sdkwork/commerce-pc-shell": "workspace:*",
    "@sdkwork/commerce-pc-subscription": "workspace:*",
    "@sdkwork/commerce-pc-wallet": "workspace:*",
    "@sdkwork/commerce-service": "workspace:*",
    "@sdkwork/runtime-bootstrap": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-commerce",
    "architecture": "pc-react",
    "domain": "commerce",
    "capability": "pc-application",
    "status": "ready"
  }
}
