{
  "name": "sdkwork-commerce-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --dir apps/sdkwork-commerce-pc dev",
    "dev:browser": "pnpm --dir apps/sdkwork-commerce-pc dev",
    "build": "pnpm --dir apps/sdkwork-commerce-pc run build:prod",
    "check": "pnpm route-manifest:check && pnpm sdk:check && pnpm db:validate && pnpm typecheck",
    "clean": "node scripts/clean-artifacts.mjs",
    "test": "pnpm test:node && pnpm test:vitest && cargo test --workspace",
    "test:node": "node --test sdks/test/*.test.mjs sdks/sdkwork-commerce-sdk/tests/*.test.mjs sdks/sdkwork-commerce-app-sdk/tests/*.test.mjs sdks/sdkwork-commerce-backend-sdk/tests/*.test.mjs",
    "test:vitest": "vitest run --config vitest.config.ts --configLoader native --pool vmThreads",
    "test:commerce-standard-contracts": "pnpm test:node && pnpm test:vitest",
    "typecheck": "tsc --noEmit",
    "fmt:rust": "cargo fmt",
    "fmt:rust:check": "cargo fmt -- --check",
    "sdk:check": "node tools/commerce_sdk_generate.mjs --check",
    "sdk:generate": "node tools/commerce_sdk_generate.mjs",
    "api:materialize": "node tools/commerce_openapi_export.mjs && node tools/commerce_route_manifest_export.mjs",
    "api:check": "node tools/commerce_openapi_export.mjs --check && node tools/commerce_route_manifest_export.mjs --check",
    "openapi:export": "node tools/commerce_openapi_export.mjs",
    "route-manifest:export": "node tools/commerce_route_manifest_export.mjs",
    "route-manifest:check": "node tools/commerce_route_manifest_export.mjs --check",
    "rpc:check": "node ../sdkwork-specs/tools/check-rpc-framework-standard.mjs",
    "verify": "pnpm check && pnpm rpc:check && pnpm test:node && pnpm test:contract:database && pnpm test:vitest && pnpm fmt:rust:check && cargo clippy --workspace --tests -- -D warnings && cargo clippy -p sdkwork-commerce-rpc --features server --tests -- -D warnings && cargo test --workspace && cargo test -p sdkwork-commerce-rpc-proto && cargo test -p sdkwork-commerce-rpc --features server",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_commerce_legacy_baseline.sql --module-id commerce --owner commerce-platform --prefixes commerce_ --engines postgres",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "test:contract:database": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "gateway:package:cloud": "node ../sdkwork-app-topology/scripts/gateway-cloud-bundle.mjs bundle --root .",
    "gateway:validate:cloud": "node ../sdkwork-app-topology/scripts/gateway-cloud-bundle.mjs validate --root .",
    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run"
  },
  "devDependencies": {
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/iam-backend-sdk": "workspace:*",
    "@sdkwork/appbase-pc-react": "workspace:*",
    "@sdkwork/runtime-bootstrap": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.1.0",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.7",
    "react-resizable-panels": "^4.9.0",
    "react-router": "catalog:",
    "react-router-dom": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
