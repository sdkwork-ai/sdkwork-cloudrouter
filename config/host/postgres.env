# SDKWork Cloud Router local PostgreSQL development profile.
# Copy this file to config/host/postgres.env and change values for your local database.
#
# SECURITY: config/host/postgres.env is git-ignored and holds this machine's local
# development values. The placeholder template is config/host/postgres.env.example.
#
# Local WSL PostgreSQL cluster for this machine:
#   18/dev on 127.0.0.1:5432 inside WSL Ubuntu-22.04, database/schema/role all
#   `sdkwork_ai_dev`. .wslconfig sets networkingMode=mirrored, so the Linux
#   loopback is shared with Windows and 127.0.0.1:5432 connects straight through.
#   Windows no longer has a native PostgreSQL install, so 5432 is free — this
#   matches config/host/postgres.env.example, the sdkwork-specs postgres tooling default
#   (5432) and the sibling sdkwork-webserver config/host/postgres.env.
# For local development only, generate a random secret with:
#   node scripts/generate-dev-secret.mjs
# Never commit real credentials. Never deploy local development credentials to
# production; the release profile refuses to start when placeholder passwords
# are detected.

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# Database lifecycle (DATABASE_FRAMEWORK_SPEC.md §8.4 / ENVIRONMENT_SPEC.md §7.1).
# Development: gateway boot auto-applies pending migrations and auto-seeds
# reference data for every federated module (base-data, payment, ...) so
# integrated applications initialize themselves. Production SHALL keep these
# false and drive lifecycle through explicit installer/release commands.
SDKWORK_DATABASE_AUTO_MIGRATE=true
SDKWORK_DATABASE_SEED_ON_BOOT=true
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_DATABASE_SEED_PROFILE=standard

# Direct app connection URL. Takes precedence over the split app fields above.
# Keep it SET so every federated module resolves the byte-identical database
# identity instead of re-synthesizing it from the split fields.
SDKWORK_DATABASE_URL=postgres://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable&options=-c%20search_path%3Dsdkwork_ai_dev

# IAM module registry manifests live in the sibling sdkwork-iam repository.
# Required for installer ensure/refresh-catalog IAM permission materialization.
# SDKWORK_IAM_APP_ROOT=../sdkwork-iam

# Required for pnpm db:postgres:init when creating roles/databases needs an admin connection.
# Runtime dev startup only needs the app account above.
# After init, db:postgres:init also installs required extensions (vector, pg_trgm).
# On Ubuntu 22.04 host PostgreSQL, install packages first:
#   bash ../sdkwork-specs/tools/postgres/install-postgres-dev-packages-ubuntu.sh
# To drop and recreate sdkwork_ai_dev from WSL:
#   bash ../sdkwork-specs/tools/postgres/recreate-dev-database.sh
SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=postgres_admin_pass
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable

# Optional: direct admin connection URL. If set, it takes precedence over split admin fields.
# The admin URL must reference the maintenance `postgres` database and the admin role,
# not the application role, so role/database provisioning can run before the app role exists.
# SDKWORK_DATABASE_ADMIN_URL=postgresql://postgres:postgres_admin_pass@127.0.0.1:5432/postgres?sslmode=disable

# Per-environment bootstrap admin identity (development uses an isolated operator account).
# Copy config/host/postgres.env to config/host/postgres.env.local and customize credentials before first boot.
#
# The install lifecycle has TWO variable names and the installer only reads the
# second one (`installer::ENV_INSTALL_ENVIRONMENT` is spelled
# `SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT`). Declaring only the first here made
# the installer fall back to its "production" default, which seeds every
# bundled vendor default account *disabled* — so no content-generation capability
# could reach a vendor API on a dev box. Keep both in sync.
SDKWORK_CLOUDROUTER_INSTALL_ENVIRONMENT=development
SDKWORK_CLOUDROUTER_ROUTER_ENVIRONMENT=development
SDKWORK_CLOUDROUTER_INSTALL_SEED_PROFILE=standard
SDKWORK_CLOUDROUTER_BOOTSTRAP_ADMIN_USERNAME=admin-dev
SDKWORK_CLOUDROUTER_BOOTSTRAP_ADMIN_DISPLAY_NAME=Cloud Router Development Administrator
SDKWORK_CLOUDROUTER_BOOTSTRAP_ADMIN_EMAIL=admin-dev@sdkwork.com

# Server development requires Redis for durable gateway accounting retries.
# The gateway accounting retry worker creates a consumer group on startup; if it
# cannot, readiness degrades and /readyz returns 503 for the whole server. The
# host Redis is the Ubuntu apt service (WSL 18/dev peer), whose /etc/redis/redis.conf
# sets `requirepass` — so the password must be supplied here.
# Do NOT also set SDKWORK_CLOUDROUTER_REDIS_URL: RedisConfig rejects combining a
# url with structured host/port/password fields.
SDKWORK_CLOUDROUTER_REDIS_ENABLED=true
SDKWORK_CLOUDROUTER_REDIS_HOST=127.0.0.1
SDKWORK_CLOUDROUTER_REDIS_PORT=6379
SDKWORK_CLOUDROUTER_REDIS_DATABASE=0
SDKWORK_CLOUDROUTER_REDIS_PASSWORD=gAYsYAUoLJKAN2Vt1iWF40yX8y15tmmq
SDKWORK_CLOUDROUTER_REDIS_KEY_PREFIX=cloudrouter
SDKWORK_CLOUDROUTER_REDIS_TLS=false
SDKWORK_CLOUDROUTER_REDIS_MAX_CONNECTIONS=16
SDKWORK_CLOUDROUTER_REDIS_CONNECT_TIMEOUT_MILLIS=2000
SDKWORK_CLOUDROUTER_REDIS_COMMAND_TIMEOUT_MILLIS=1000
SDKWORK_CLOUDROUTER_REDIS_POOL_IDLE_TIMEOUT_SECONDS=60

# Server runtime secrets required by sdkwork-app dev (the `pnpm dev` path).
# The retired start-workspace orchestrator used to fall back to this same dev
# constant; keeping the identical value here preserves ciphertexts already
# encrypted in the local dev database. Rotate with scripts/generate-dev-secret.mjs
# if you ever need machine-local values.
SDKWORK_CLOUDROUTER_API_KEY_PEPPER=sdkwork-cloudrouter-local-dev-secret-20260507
SDKWORK_CLOUDROUTER_TRUSTED_SUBJECT_SECRET=sdkwork-cloudrouter-local-dev-secret-20260507
SDKWORK_CLOUDROUTER_APP_SESSION_SECRET=sdkwork-cloudrouter-local-dev-secret-20260507

# Security material files (git-ignored under .sdkwork/secrets/). The paths are
# resolved relative to the repository root, which is the gateway process cwd.
SDKWORK_CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING_FILE=.sdkwork/secrets/upstream-credential-key-ring.development.json
SDKWORK_CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET_FILE=.sdkwork/secrets/internal-gateway-signing.development.secret

# Sibling application roots (IAM_APPLICATION_BOOTSTRAP_ENV in the retired
# start-workspace orchestrator). The gateway reads the federated module roots
# below during boot; these MUST be absolute paths because the database seeder
# rejects seed files whose joined path escapes its seeds directory, so relative
# `../sdkwork-*` values are treated as path traversal. SDKWORK_IAM_APP_ROOT is
# intentionally NOT listed here: the topology runtime aliases that key from the
# lifecycle env, so it is declared in etc/topology/standalone.development.env.
SDKWORK_LOG_APP_ROOT=D:/sdkwork-space/sdkwork-log
SDKWORK_ACCOUNT_APP_ROOT=D:/sdkwork-space/sdkwork-account
SDKWORK_PAYMENT_APP_ROOT=D:/sdkwork-space/sdkwork-payment
SDKWORK_PROMOTION_APP_ROOT=D:/sdkwork-space/sdkwork-promotion
SDKWORK_MEMBERSHIP_APP_ROOT=D:/sdkwork-space/sdkwork-membership
SDKWORK_ORDER_APP_ROOT=D:/sdkwork-space/sdkwork-order
SDKWORK_SHOP_APP_ROOT=D:/sdkwork-space/sdkwork-shop
SDKWORK_CATALOG_APP_ROOT=D:/sdkwork-space/sdkwork-catalog
SDKWORK_INVOICE_APP_ROOT=D:/sdkwork-space/sdkwork-invoice
