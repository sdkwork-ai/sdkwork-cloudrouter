                    "verify:fast": "node scripts/verify-claw-router-application.mjs --fast",
                    "verify:precommit": "node scripts/verify-claw-router-application.mjs --precommit",
                    "verify:ci": "node scripts/verify-claw-router-application.mjs --ci",
                    "verify:parallel": "node scripts/verify-claw-router-application.mjs --parallel",
                    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix clawrouter,claw",
                    "check:agent-workflow-standard": "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
                    "check:iam-web-adapter-standard": "node ../sdkwork-specs/tools/check-iam-web-adapter-standard.mjs --root .",
                    "sdk:file:artifacts:check": "node scripts/materialize-file-sdk-artifacts.mjs --check",
                    "sdk:file:artifacts:write": "node scripts/materialize-file-sdk-artifacts.mjs --apply",
                    "api:materialize:check": "node scripts/materialize-apis-contracts.mjs --check",
                    "api:materialize:write": "node scripts/materialize-apis-contracts.mjs --apply",
                    "api:standard-extensions:check": "node tools/sync-clawrouter-api-standard-extensions.mjs --check",
                    "api:standard-extensions:write": "node tools/sync-clawrouter-api-standard-extensions.mjs --apply",
                    "api:http-route-manifest:check": "node tools/generate-clawrouter-http-route-manifest-rs.mjs --check",
                    "api:http-route-manifest:write": "node tools/generate-clawrouter-http-route-manifest-rs.mjs --apply",
                    "models:check": "node scripts/lib/ensure-models-catalog-deps.mjs && node ../sdkwork-models/tools/build-index.mjs --check && node ../sdkwork-models/tools/validate-catalog.mjs && node ../sdkwork-models/tools/freshness-report.mjs --max-age-policy catalog-freshness-policy.json --as-of-catalog-generated-at && node ../sdkwork-models/tools/catalog-audit.mjs && node ../sdkwork-models/tools/release-catalog.mjs --check",
                    "downloads:update": "node scripts/update-claw-router-downloads.mjs",
                    "downloads:check": "node scripts/update-claw-router-downloads.mjs --check",
                    "skills:seed:mirror-clawhub": "node scripts/mirror-clawhub-skills-seed.mjs --fetch",
                    "skills:seed:check": "node scripts/mirror-clawhub-skills-seed.mjs --check",
                    "app-store:seed:update": "node scripts/update-app-store-seed.mjs",
                    "app-store:seed:check": "node scripts/update-app-store-seed.mjs --check",
                    "install:packages:plan": "node scripts/plan-claw-router-install-packages.mjs",
                    "install:packages:check": "node scripts/plan-claw-router-install-packages.mjs --check",
                    "install:package:build": "node scripts/build-claw-router-install-package.mjs",
                    "install:package:check": "node scripts/build-claw-router-install-package.mjs --check --dry-run --all",
                    "install:native:build": "node scripts/build-claw-router-native-installer.mjs",
                    "install:native:check": "node scripts/build-claw-router-native-installer.mjs --check --dry-run --all",
                    "install:init:smoke": "node scripts/smoke-install-package-init.mjs --check --dry-run",
                    "nginx:plan": "node scripts/configure-nginx.mjs --dry-run",
                    "nginx:render": "node scripts/configure-nginx.mjs --write",
                    "nginx:deploy": "node scripts/configure-nginx.mjs --deploy",
                    "check:alignment:audit": "python tools/sdkwork_standard_alignment_guardian.py && node scripts/refresh-standard-alignment-audit.mjs",
                    "check:alignment": "python tools/sdkwork_standard_alignment_guardian.py --strict && node scripts/refresh-standard-alignment-audit.mjs --strict",
                    "check:alignment:audit:facts": "node scripts/refresh-standard-alignment-audit.mjs",
                    "check:alignment:audit:facts:check": "node scripts/refresh-standard-alignment-audit.mjs --check",
                    "db:materialize:contract": "python -B -m tools.database_contract_materializer --root .",
                    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
                    "db:pool:validate": "node ../sdkwork-specs/tools/check-process-shared-database-pool.mjs --root .",
                    "check:database-ownership": "node scripts/check-database-ownership.mjs",
                    "check:application-env": "node --test scripts/lib/claw-router-browser-env-contract.test.mjs scripts/lib/claw-router-edge-env-contract.test.mjs scripts/dev/claw-router-application-env.test.mjs scripts/dev/ensure-claw-router-env.test.mjs scripts/write-release-env.test.mjs scripts/release-environment-validation.test.mjs && node scripts/check-claw-router-application-env.mjs",
                    "check:gateway-request-identity": "node scripts/check-claw-router-gateway-request-identity.mjs",
                    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
                    "check:vendor-workspace": "node scripts/check-vendor-workspace.mjs",
                    "check:commerce-debt": "node scripts/check-commerce-debt.mjs --report",
                    "check:commerce-debt:strict": "node scripts/check-commerce-debt.mjs",
                    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
                    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
                    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
                    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
                    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
                    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
                    "test:contract:database": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
                    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
                    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
                    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
                    "db:postgres:init": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode init --config .env.postgres --app-root .",
                    "db:postgres:plan": "node ../sdkwork-specs/tools/postgres/postgres-db-cli.mjs --mode plan --config .env.postgres --app-root . --dry-run",
                    "db:postgres:recreate": "bash ../sdkwork-specs/tools/postgres/recreate-dev-database.sh",
                    "_sdkwork:dev:standalone": "node scripts/claw-router-dev.mjs --target browser --deployment-profile standalone --database postgres",
                    "_sdkwork:build": "node scripts/build-claw-router-production.mjs",
                    "_sdkwork:test": "pnpm topology:validate && pnpm test:topology && node scripts/run-claw-router-application.test.mjs",
                    "_sdkwork:check": "pnpm check:application-env && pnpm check:gateway-request-identity && pnpm check:app-composition && pnpm check:vendor-workspace && pnpm check:commerce-debt && node scripts/run-claw-router-application.mjs check",
                    "_sdkwork:verify": "node scripts/verify-claw-router-application.mjs && pnpm run check:app-composition",
                    "_sdkwork:clean": "node scripts/clean-claw-router-workspace.mjs",
                    "dev:standalone": "pnpm exec sdkwork-app dev --deployment-profile standalone",
                    "dev:cloud": "pnpm exec sdkwork-app dev --deployment-profile cloud",
                    "release:preflight:standalone": "pnpm exec sdkwork-app release:preflight --deployment-profile standalone",
                    "release:preflight:cloud": "pnpm exec sdkwork-app release:preflight --deployment-profile cloud",
                    "release:package:standalone": "pnpm exec sdkwork-app release:package --deployment-profile standalone",
                    "release:package:cloud": "pnpm exec sdkwork-app release:package --deployment-profile cloud",
                    "dev:browser:cloud": "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile cloud",
                    "dev:browser:cloud:debug": "node scripts/claw-router-dev.mjs --target browser --deployment-profile cloud --distributed --database postgres --dev-env-file .env.postgres",
                    "_sdkwork:release:package": "node scripts/build-claw-router-install-package.mjs"
          },
          "pnpm": {
                    "overrides": {
                              "@types/react": "^19.0.0",
                              "@types/react-dom": "^19.0.0"
                    },
                    "packageExtensions": {
                              "@sdkwork/models-pc-admin-catalog": {
                                        "dependencies": {
                                                  "@sdkwork/clawroutes-pc-commons": "workspace:*"
                                        }
                              },
                              "@sdkwork/models-pc-admin-resource": {
                                        "dependencies": {
                                                  "@sdkwork/clawroutes-pc-commons": "workspace:*"
                                        }
                              },
                              "@sdkwork/image-pc-generation": {
                                        "dependencies": {
                                                  "@sdkwork/assets-pc-assets": "workspace:*",
                                                  "@sdkwork/generations-pc-studio": "workspace:*",
                                                  "@sdkwork/generations-pc-workspace": "workspace:*",
                                                  "@sdkwork/ui-pc-react": "workspace:*"
                                        }
                              },
                              "@sdkwork/generations-pc-studio": {
                                        "dependencies": {
                                                  "@sdkwork/utils": "workspace:*"
                                        }
                              },
                              "@sdkwork/video-pc-generation": {
                                        "dependencies": {
                                                  "@sdkwork/assets-pc-assets": "workspace:*",
                                                  "@sdkwork/generations-pc-studio": "workspace:*",
                                                  "@sdkwork/ui-pc-react": "workspace:*"
                                        }
                              },
                              "@sdkwork/music-pc-generation": {
                                        "dependencies": {
                                                  "@sdkwork/assets-pc-assets": "workspace:*",
                                                  "@sdkwork/generations-pc-studio": "workspace:*",
                                                  "@sdkwork/ui-pc-react": "workspace:*"
                                        }
                              },
                              "@sdkwork/audio-pc-generation": {
                                        "dependencies": {
                                                  "@sdkwork/assets-pc-assets": "workspace:*",
                                                  "@sdkwork/generations-pc-studio": "workspace:*",
                                                  "@sdkwork/ui-pc-react": "workspace:*"
                                        }
                              },
                              "@sdkwork/assets-pc-assets": {
                                        "dependencies": {
                                                  "@sdkwork/models-pc-picker": "workspace:*"
                                        }
                              },
                              "@sdkwork/image-pc": {
                                        "dependencies": {
                                                  "@sdkwork/ui-pc-react": "workspace:*"
                                        }
                              }
                    },
                    "peerDependencyRules": {
                              "allowAny": [
                                        "@sdkwork/ui-pc-react",
                                        "@sdkwork/clawroutes-pc-commons",
                                        "@sdkwork/clawrouter-pc-commons",
                                        "@sdkwork/appbase-pc-react",
                                        "@sdkwork/core-pc-react"
                              ]
                    }
          },
          "exports": {
                    ".": {
                              "types": "./src/index.ts",
                              "import": "./src/index.ts",
                              "default": "./src/index.ts"
                    }
          }
}
