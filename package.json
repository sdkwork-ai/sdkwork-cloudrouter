                    "topology:plan:server": "node scripts/claw-router-dev.mjs --target plan --deployment-profile standalone --database postgres --dev-env-file .env.postgres",
                    "topology:plan:server:postgres": "node scripts/claw-router-dev.mjs --target plan --deployment-profile standalone --database postgres --dev-env-file .env.postgres",
                    "topology:plan:server:sqlite": "node scripts/claw-router-dev.mjs --target plan --deployment-profile standalone --database sqlite",
                    "test:topology": "node --test --experimental-test-isolation=none scripts/verify-claw-router-topology.test.mjs",
                    "gateway:run:standalone": "cargo run -p sdkwork-api-clawrouter-standalone-gateway --bin sdkwork-api-clawrouter-standalone-gateway",
                    "gateway:build:standalone": "cargo build -p sdkwork-api-clawrouter-standalone-gateway --bin sdkwork-api-clawrouter-standalone-gateway",
                    "gateway:package:standalone": "cargo build -p sdkwork-api-clawrouter-standalone-gateway --release --bin sdkwork-api-clawrouter-standalone-gateway",
                    "gateway:validate:standalone": "cargo check -p sdkwork-api-clawrouter-standalone-gateway",
                    "gateway:matrix": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs print-matrix --root . --spec specs/topology.spec.json --profile all",
                    "sbom:release": "node scripts/generate-release-sbom.mjs",
                    "test:tooling": "node scripts/run-claw-router-application.test.mjs && node --test scripts/stop-claw-router-application.test.mjs",
                    "test:rust:auto": "node scripts/run-claw-router-rust-tests.mjs auto",
                    "test:rust:smoke": "node scripts/run-claw-router-rust-tests.mjs smoke",
                    "test:rust:quick": "node scripts/run-claw-router-rust-tests.mjs quick",
                    "test:rust:admin-api": "node scripts/run-claw-router-rust-tests.mjs admin-api",
                    "test:rust:app-api": "node scripts/run-claw-router-rust-tests.mjs app-api",
                    "test:rust:gateway": "node scripts/run-claw-router-rust-tests.mjs gateway",
                    "test:rust:product-relay": "node scripts/run-claw-router-rust-tests.mjs product-relay",
                    "test:rust:runtime": "node scripts/run-claw-router-rust-tests.mjs runtime",
                    "test:rust:full": "node scripts/run-claw-router-rust-tests.mjs full",
                    "test:rust:measure": "node scripts/measure-claw-router-test-targets.mjs",
                    "test:rust:stop": "node scripts/stop-claw-router-test-processes.mjs",
                    "smoke:dev": "node scripts/smoke-edge-dev-server.mjs",
                    "test:postgres": "node scripts/run-postgres-integration.mjs",
                    "test:postgres:required": "node scripts/run-postgres-integration.mjs --require-database",
                    "test:postgres:docker": "node scripts/run-postgres-integration.mjs --with-docker",
