    "test:topology": "node --test --experimental-test-isolation=none scripts/verify-cloud-router-topology.test.mjs",
    "test:web-domain-routing-standard": "node scripts/dev/sdkwork-cloudrouter-web-domain-routing-standard.test.mjs",
