    "gateway:build:standalone": "cargo build -p sdkwork-api-cloudrouter-standalone-gateway --bin sdkwork-api-cloudrouter-standalone-gateway",
    "gateway:package:standalone": "cargo build -p sdkwork-api-cloudrouter-standalone-gateway --release --bin sdkwork-api-cloudrouter-standalone-gateway",
    "gateway:validate:standalone": "cargo check -p sdkwork-api-cloudrouter-standalone-gateway",
    "gateway:matrix": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs print-matrix --root . --spec specs/topology.spec.json --profile all",
    "sbom:release": "node scripts/generate-release-sbom.mjs",
    "test:tooling": "node scripts/run-cloud-router-application.test.mjs && node --test scripts/stop-cloud-router-application.test.mjs scripts/lib/standard-alignment-runtime-facts.test.mjs",
    "test:rust:auto": "node scripts/run-cloud-router-rust-tests.mjs auto",
    "test:rust:smoke": "node scripts/run-cloud-router-rust-tests.mjs smoke",
    "test:rust:quick": "node scripts/run-cloud-router-rust-tests.mjs quick",
    "test:rust:admin-api": "node scripts/run-cloud-router-rust-tests.mjs admin-api",
    "test:rust:app-api": "node scripts/run-cloud-router-rust-tests.mjs app-api",
    "test:rust:gateway": "node scripts/run-cloud-router-rust-tests.mjs gateway",
    "test:rust:product-relay": "node scripts/run-cloud-router-rust-tests.mjs product-relay",
    "test:rust:runtime": "node scripts/run-cloud-router-rust-tests.mjs runtime",
    "test:rust:full": "node scripts/run-cloud-router-rust-tests.mjs full",
    "test:rust:measure": "node scripts/measure-cloud-router-test-targets.mjs",
    "test:rust:stop": "node scripts/stop-cloud-router-test-processes.mjs",
    "smoke:dev": "node scripts/smoke-edge-dev-server.mjs",
    "test:postgres": "node scripts/run-postgres-integration.mjs",
    "test:postgres:required": "node scripts/run-postgres-integration.mjs --require-database",
    "test:postgres:docker": "node scripts/run-postgres-integration.mjs --with-docker",
    "verify": "pnpm exec sdkwork-app verify",
    "verify:fast": "node scripts/verify-cloud-router-application.mjs --fast",
    "verify:precommit": "node scripts/verify-cloud-router-application.mjs --precommit",
    "verify:ci": "node scripts/verify-cloud-router-application.mjs --ci",
    "verify:parallel": "node scripts/verify-cloud-router-application.mjs --parallel",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix cloudrouter,cloud",
    "check:agent-workflow-standard": "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
    "check:package-content": "node ../sdkwork-specs/tools/check-package-content-standard.mjs --workspace .",
    "check:portal-dist": "node scripts/check-portal-dist-consistency.mjs --check",
    "check:packaging": "pnpm check:package-content && pnpm check:portal-dist && pnpm build:container:check && pnpm install:packages:check && pnpm install:native:check",
    "check:iam-web-adapter-standard": "node ../sdkwork-specs/tools/check-iam-web-adapter-standard.mjs --root .",
