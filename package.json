{
          "name": "sdkwork-clawrouter-workspace",
          "version": "0.3.0",
          "private": true,
          "license": "AGPL-3.0-or-later",
          "type": "module",
          "packageManager": "pnpm@10.33.0",
          "dependencies": {
                    "@sdkwork/app-topology": "workspace:*",
                    "@sdkwork/iam-application-bootstrap": "workspace:*",
                    "@sdkwork/sdk-common": "link:../sdkwork-sdk-commons/sdkwork-sdk-common-typescript"
          },
          "scripts": {
                    "workflow:materialize-client-env": "node ../sdkwork-specs/tools/materialize-client-env.mjs --root .",
                    "check:client-env": "node ../sdkwork-specs/tools/materialize-client-env.mjs --root . --check",
                    "install:deps:ensure": "node scripts/lib/ensure-claw-router-node-deps.mjs",
                    "dev": "pnpm dev:standalone",
                    "stop": "pnpm exec sdkwork-app stop",
                    "dev:browser": "pnpm dev:browser:postgres:standalone",
                    "dev:browser:postgres": "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile standalone",
                    "dev:browser:sqlite": "node scripts/claw-router-dev.mjs --target browser --deployment-profile standalone --database sqlite",
                    "dev:browser:postgres:standalone": "pnpm exec sdkwork-app dev --runtime-target browser --deployment-profile standalone",
                    "dev:browser:postgres:standalone:debug": "node scripts/claw-router-dev.mjs --target browser --deployment-profile standalone --distributed --database postgres --dev-env-file .env.postgres",
                    "dev:server": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
                    "dev:server:postgres": "pnpm exec sdkwork-app dev --runtime-target server --deployment-profile standalone",
                    "dev:server:sqlite": "node scripts/claw-router-dev.mjs --target browser --deployment-profile standalone --database sqlite",
                    "dev:desktop": "pnpm dev:desktop:postgres:standalone",
                    "dev:desktop:postgres": "pnpm exec sdkwork-app dev --runtime-target desktop --deployment-profile standalone",
                    "dev:desktop:postgres:standalone": "pnpm exec sdkwork-app dev --runtime-target desktop --deployment-profile standalone",
                    "dev:desktop:sqlite": "node scripts/claw-router-dev.mjs --target desktop --deployment-profile standalone --database sqlite",
                    "test": "pnpm exec sdkwork-app test",
                    "build": "pnpm exec sdkwork-app build",
                    "start": "node scripts/start-claw-router-production.mjs",
                    "check": "pnpm exec sdkwork-app check",
                    "clean": "pnpm exec sdkwork-app clean",
                    "clean:fast": "node scripts/clean-claw-router-workspace.mjs",
                    "typecheck": "pnpm --dir apps/sdkwork-clawrouter-pc typecheck",
                    "lint": "pnpm --dir apps/sdkwork-clawrouter-pc lint",
                    "format": "node scripts/cargo-fmt-workspace.mjs",
                    "format:rust": "node scripts/cargo-fmt-workspace.mjs",
                    "format:check": "node scripts/cargo-fmt-workspace.mjs --check",
                    "format:rust:check": "node scripts/cargo-fmt-workspace.mjs --check",
                    "release": "pnpm downloads:check && pnpm release:env:write -- --check && pnpm release:env:write -- --force && pnpm release:preflight -- --strict --env-file .env.release --strict-root-clean && pnpm verify",
                    "release:preflight": "node scripts/release-preflight.mjs",
                    "release:env:write": "node scripts/write-release-env.mjs",
                    "release:plan": "pnpm exec sdkwork-app release:plan",
                    "release:plan:standalone": "pnpm exec sdkwork-app release:plan --deployment-profile standalone",
                    "release:plan:cloud": "pnpm exec sdkwork-app release:plan --deployment-profile cloud",
                    "release:package": "pnpm release:package:standalone",
                    "release:package:check": "node scripts/build-claw-router-install-package.mjs --check --dry-run --all",
                    "release:native:package": "node scripts/build-claw-router-native-installer.mjs",
                    "release:native:check": "node scripts/build-claw-router-native-installer.mjs --check --dry-run --all",
                    "admin:reset:dev": "node scripts/reset-admin-account.mjs --mode dev",
                    "admin:reset:dev:sqlite": "node scripts/reset-admin-account.mjs --mode dev --database-url \"sqlite://target/dev/clawrouter.sqlite\"",
                    "admin:reset:dev:postgres": "node scripts/reset-admin-account.mjs --mode dev --dev-env-file .env.postgres",
                    "admin:reset:release": "node scripts/reset-admin-account.mjs --mode release",
                    "db": "node scripts/manage-claw-router-database.mjs",
                    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
                    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
