    "sdk:file:artifacts:write": "node scripts/materialize-file-sdk-artifacts.mjs --apply",
    "api:materialize:check": "node scripts/materialize-apis-contracts.mjs --check",
    "api:materialize:write": "node scripts/materialize-apis-contracts.mjs --apply",
    "api:standard-extensions:check": "node tools/sync-cloudrouter-api-standard-extensions.mjs --check",
    "api:standard-extensions:write": "node tools/sync-cloudrouter-api-standard-extensions.mjs --apply",
    "api:http-route-manifest:check": "node tools/generate-cloudrouter-http-route-manifest-rs.mjs --check",
    "api:http-route-manifest:write": "node tools/generate-cloudrouter-http-route-manifest-rs.mjs --apply",
