{
  "name": "@sdkwork/clawrouter-backend-sdk",
  "version": "0.1.0",
  "sdkworkRole": "composed-facade",
  "description": "SDKWork clawrouter-backend-sdk composed consumer facade.",
  "author": "SDKWork Team",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domains": {
      "types": "./src/domains/index.ts",
      "import": "./src/domains/index.ts",
      "default": "./src/domains/index.ts"
    }
  },
  "scripts": {
    "build": "node custom/build-runtime.mjs",
    "dev": "node custom/build-runtime.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sdkwork/sdk-common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "typescript": "5.8.3",
    "rollup": "4.60.1"
  },
  "keywords": [
    "sdk",
    "api",
    "backend",
    "sdkwork"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
