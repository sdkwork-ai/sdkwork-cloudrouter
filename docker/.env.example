# sdkwork-cloudrouter docker compose environment template.
# Copy to the repository root as `.env`, then generate the per-deployment
# runtime secrets in one step:
#   cp docker/.env.example .env
#   node scripts/generate-dev-secrets.mjs
# docker compose reads `.env` next to docker-compose.yml automatically.
# The five CLOUDROUTER_* runtime secrets below are MANDATORY: compose refuses
# to start while any of them is empty, and the runtime rejects known-default
# secret material in production-like environments.

# --- Process log level (tracing reads RUST_LOG directly) ---
# Set to debug/trace to increase verbosity at deployment time.
RUST_LOG=info

# --- Gateway resource guardrails (docker compose deploy limits) ---
CLOUDROUTER_CPU_LIMIT=4.0
CLOUDROUTER_MEMORY_LIMIT=4g
CLOUDROUTER_CPU_RESERVATION=1.0
CLOUDROUTER_MEMORY_RESERVATION=1g

# --- Connection pools (high concurrency) ---
# PostgreSQL app pool. Rule of thumb: ~CPU cores x 4, capped; keep
# PG_MAX_CONNECTIONS comfortably above it. 50 suits most 4-16 core hosts;
# scale up on larger instances (e.g. 100 on 32+ cores) together with
# PG_MAX_CONNECTIONS.
SDKWORK_DATABASE_MAX_CONNECTIONS=50
SDKWORK_DATABASE_MIN_CONNECTIONS=5
SDKWORK_DATABASE_ACQUIRE_TIMEOUT=30
SDKWORK_DATABASE_IDLE_TIMEOUT=600
SDKWORK_DATABASE_MAX_LIFETIME=1800
# Redis pool (connections are lightweight; 50 covers high read concurrency).
CLOUDROUTER_REDIS_MAX_CONNECTIONS=50
# Redis-outage rate-limit fallback: when the distributed limiter degrades to
# per-process enforcement, each replica divides the configured quota by this
# fleet estimate. Keep it equal to the deployment replica count (the compose
# stack runs one gateway, so 1; the k8s manifest sets 2 to match its replicas).
SDKWORK_CLOUDROUTER_PROVIDER_RATE_LIMIT_ESTIMATED_INSTANCE_COUNT=1
# PostgreSQL server-side connection ceiling (default 200).
PG_MAX_CONNECTIONS=200

# --- PostgreSQL (compose `postgres` service) ---
CLOUDROUTER_POSTGRES_DB=sdkwork_ai_prod
CLOUDROUTER_POSTGRES_USER=sdkwork_ai_prod
# Change this password; the same value must reach the app via the database URL.
CLOUDROUTER_POSTGRES_PASSWORD=sdkwork_ai_prod

# --- Runtime secrets (MANDATORY — filled by scripts/generate-dev-secrets.mjs) ---
# Never copy values between deployments. Production should prefer the *_FILE
# variants with mounted secrets instead of plain environment values.
CLOUDROUTER_API_KEY_PEPPER=
# Upstream credential encryption key ring (JSON, keys >= 32 bytes). Encrypts
# every tenant upstream credential at rest — must be unique per deployment.
CLOUDROUTER_UPSTREAM_CREDENTIAL_KEY_RING=
CLOUDROUTER_INTERNAL_GATEWAY_SIGNING_SECRET=
CLOUDROUTER_TRUSTED_SUBJECT_SECRET=
CLOUDROUTER_APP_SESSION_SECRET=
# Sandbox payment registry (1) or real providers (0 + provider secrets).
CLOUDROUTER_PAYMENT_SANDBOX=1

# --- IAM bootstrap accounts ---
# Default admin password credential, provisioned at startup when set.
# Production must set a strong password here (or via SDKWORK_IAM_BOOTSTRAP_PASSWORD).
SDKWORK_IAM_SUPER_ADMIN_PASSWORD=

# --- IAM credential-entry bootstrap Access-Token (development only) ---
# The gateway never injects a signed or session-bound token into the portal
# runtime script. For local development the IAM development authentication
# fallback accepts a payload-only bootstrap token, which is injected only when
# this explicit switch is enabled:
# SDKWORK_CLOUDROUTER_PORTAL_DEV_BOOTSTRAP_TOKEN=true
# Optional overrides for the auto-generated token scope (defaults match the
# installer-provisioned tenant runtime app):
# SDKWORK_WEB_FRAMEWORK_JWT_BOOTSTRAP_TENANT_ID=100001
# SDKWORK_WEB_FRAMEWORK_JWT_BOOTSTRAP_APP_ID=sdkwork-cloudrouter

# --- Commercial license (docs/commercial/LICENSING.md) ---
# Community edition runs without a license. Pro/Enterprise/OEM require a
# signed license key (issue via tools/generate-license-key.mjs):
# SDKWORK_CLOUDROUTER_LICENSE_KEY=v1.<payload>.<signature>
# Or mount the key file (default /etc/sdkwork/router/license.key):
#   ./docker/config/license.key:/etc/sdkwork/router/license.key:ro
# SDKWORK_CLOUDROUTER_LICENSE_FILE=/etc/sdkwork/router/license.key

# --- Commercial operation workers (all disabled by default) ---
# Enable after the platform tenant id is fixed; every worker requires
# TENANT_ID > 0 or the matching *_PLATFORM_SCOPE=true opt-in.
# Metering retention: bounded storage for settled usage facts.
# SDKWORK_CLOUDROUTER_METERING_RETENTION_ENABLED=true
# SDKWORK_CLOUDROUTER_METERING_RETENTION_TENANT_ID=1
# SDKWORK_CLOUDROUTER_METERING_RETENTION_DAYS=180
# Payment reconciliation: consumes queued payment-center reconciliation runs
# (requires the sdkwork-payment schema and the statement import pipeline).
# SDKWORK_CLOUDROUTER_PAYMENT_RECONCILIATION_ENABLED=true
# SDKWORK_CLOUDROUTER_PAYMENT_RECONCILIATION_TENANT_ID=1
# Upstream credential rotation: promotes pre-provisioned candidate credentials
# on schedule and deactivates expired ones.
# SDKWORK_CLOUDROUTER_CREDENTIAL_ROTATION_ENABLED=true
# SDKWORK_CLOUDROUTER_CREDENTIAL_ROTATION_TENANT_ID=1
# SDKWORK_CLOUDROUTER_CREDENTIAL_ROTATION_DEFAULT_INTERVAL_DAYS=90

# --- Browser CORS allow-list (API plane) ---
# The gateway is in production posture, so every origin that serves the
# portal from a browser must be listed here (comma/space separated).
# Defaults cover the three test domains plus local host ports. This is the
# canonical shared key (SOURCE_CONFIG_SPEC) used by both the IAM and Cloud
# Router API surfaces; docker-compose.yml maps it into the container as-is.
SDKWORK_CORS_ALLOWED_ORIGINS=http://testrouterdocker.sdkwork.com,http://testdocker.birdcoder.com,http://localhost:3903,http://127.0.0.1:3903,https://router-dev.sdkwork.com,http://router-dev.sdkwork.com,https://router-dev.birdcoder.com,http://router-dev.birdcoder.com,https://router-dev.dtupay.com,http://router-dev.dtupay.com,https://router-dev.noaper.com,http://router-dev.noaper.com,https://router-dev.sdkwork.cn,http://router-dev.sdkwork.cn,https://router-dev.birdcoder.cn,http://router-dev.birdcoder.cn,https://router-dev.dtupay.cn,http://router-dev.dtupay.cn,https://router-dev.noaper.cn,http://router-dev.noaper.cn,https://router-dev.skubc.com,http://router-dev.skubc.com,https://router-dev.skubc.cn,http://router-dev.skubc.cn,https://router-dev.zowalk.com,http://router-dev.zowalk.com,https://router-dev.zowalk.cn,http://router-dev.zowalk.cn,https://router-dev.offer86.com,http://router-dev.offer86.com,https://router-dev.offer86.cn,http://router-dev.offer86.cn,https://router-dev.86offer.com,http://router-dev.86offer.com,https://router-dev.86offer.cn,http://router-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com

# --- External PostgreSQL/Redis override (production) ---
# Set these to point the container at managed services instead of the compose
# services, and unset/replace the compose dependency wiring accordingly.
# CLOUDROUTER_POSTGRES_HOST=db.example.com
# CLOUDROUTER_POSTGRES_PORT=5432
# SDKWORK_CLOUDROUTER_REDIS_HOST=redis.example.com
# SDKWORK_CLOUDROUTER_REDIS_PORT=6379
