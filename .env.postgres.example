# SDKWork Claw Router local PostgreSQL development profile.
# Copy this file to .env.postgres and change values for your local database.
#
# SECURITY: Every password below uses the <CHANGE_ME> placeholder.
# Replace each <CHANGE_ME> with a real secret before starting the stack.
# For local development only, generate a random secret with:
#   node scripts/generate-dev-secret.mjs
# Never commit real credentials. Never deploy <CHANGE_ME> to production;
# the release profile refuses to start when placeholder passwords are detected.

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA_FALLBACK_PUBLIC=false
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=<CHANGE_ME>
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# Optional: direct app connection URL. If set, it takes precedence over split app fields.
# Keep this commented unless you need to test a full URL explicitly.
# SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:<CHANGE_ME>@127.0.0.1:5432/sdkwork_ai_dev?sslmode=disable

# IAM module registry manifests live in the sibling sdkwork-iam repository.
# Required for installer ensure/refresh-catalog IAM permission materialization.
# SDKWORK_IAM_APP_ROOT=../sdkwork-iam

# Required for pnpm db:postgres:init when creating roles/databases needs an admin connection.
# Runtime dev startup only needs the app account above.
# After init, db:postgres:init also installs required extensions (vector, pg_trgm).
# On Ubuntu 22.04 host PostgreSQL, install packages first:
#   bash ../sdkwork-specs/tools/postgres/install-postgres-dev-packages-ubuntu.sh
# To drop and recreate sdkwork_ai_dev from WSL:
#   bash ../sdkwork-specs/tools/postgres/recreate-dev-database.sh
SDKWORK_DATABASE_ADMIN_HOST=127.0.0.1
SDKWORK_DATABASE_ADMIN_PORT=5432
SDKWORK_DATABASE_ADMIN_USERNAME=postgres
SDKWORK_DATABASE_ADMIN_PASSWORD=<CHANGE_ME>
SDKWORK_DATABASE_ADMIN_DATABASE=postgres
SDKWORK_DATABASE_ADMIN_SSL_MODE=disable

# Optional: direct admin connection URL. If set, it takes precedence over split admin fields.
# SDKWORK_DATABASE_ADMIN_URL=postgresql://postgres:<CHANGE_ME>@127.0.0.1:5432/postgres?sslmode=disable

# Server development requires Redis for durable gateway accounting retries.
SDKWORK_CLAW_REDIS_ENABLED=true
SDKWORK_CLAW_REDIS_HOST=127.0.0.1
SDKWORK_CLAW_REDIS_PORT=6379
SDKWORK_CLAW_REDIS_DATABASE=0
SDKWORK_CLAW_REDIS_KEY_PREFIX=clawrouter
SDKWORK_CLAW_REDIS_TLS=false
SDKWORK_CLAW_REDIS_MAX_CONNECTIONS=16
SDKWORK_CLAW_REDIS_CONNECT_TIMEOUT_MILLIS=2000
SDKWORK_CLAW_REDIS_COMMAND_TIMEOUT_MILLIS=1000
SDKWORK_CLAW_REDIS_POOL_IDLE_TIMEOUT_SECONDS=60
